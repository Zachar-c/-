[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/presentation/widgets/debug_panel_view.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/widgets/gu_toast.tscn" id="2_toast"]

[node name="DebugPanel" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="Body" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HeaderRow" type="HBoxContainer" parent="Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="Margin/Body/HeaderRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "调试"

[node name="SubLabel" type="Label" parent="Margin/Body/HeaderRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "DEV ONLY · F12"

[node name="ToggleButton" type="Button" parent="Margin/Body/HeaderRow"]
layout_mode = 2
text = "展开 ▼"

[node name="BodyHost" type="VBoxContainer" parent="Margin/Body"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="FeedbackToast" parent="Margin/Body" instance=ExtResource("2_toast")]
layout_mode = 2
visible = false
