[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/presentation/widgets/gu_panel_view.gd" id="1_panel"]

[node name="GuPanel" type="PanelContainer"]
script = ExtResource("1_panel")

[node name="PanelMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_bottom = 12

[node name="PanelBody" type="VBoxContainer" parent="PanelMargin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleRow" type="HBoxContainer" parent="PanelMargin/PanelBody"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="PanelMargin/PanelBody/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "标题"

[node name="ContentHost" type="VBoxContainer" parent="PanelMargin/PanelBody"]
layout_mode = 2
theme_override_constants/separation = 8
