import { GuButton } from "~/ui/widgets/gu_button"

# P0-2: one compact card body per hand card. Detailed information is shown
# by BattleScreen's shared tooltip only while the card is hovered or selected.
# A1 drag-card-onto-enemy: the card Button captures the mouse while pressed, so
# every left release (including releases dragged off the card) arrives back on
# this Button. We forward the release's global point to the host via on_release;
# the host hit-tests it against enemy actors. Releases inside the card (plain
# clicks) miss every enemy and keep the onPressed click path intact.
export GuBattleHand() -> RuitkVNode {
  var MasterTheme = preload("res://scripts/presentation/wenzhen_master_theme.gd")
  var cards = props.get("cards", [])
  var interaction = props.get("interaction", {})
  var on_press = props.get("on_press", func(_card = {}): pass)
  var on_hover = props.get("on_hover", func(_card = {}): pass)
  var on_release = props.get("on_release", func(_card = {}, _global_pos = Vector2.ZERO): pass)
  var on_cancel = props.get("on_cancel", func(): pass)
  var card_nodes = useRef({})
  var handle_card_input = func(card, executable, card_id, event):
    if (event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_RIGHT and event.pressed) or (event is InputEventKey and event.keycode == KEY_ESCAPE and event.pressed):
      on_cancel.call()
      return
    if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed and executable:
      var btn = card_nodes["current"].get(card_id)
      var release_pos = btn.get_global_rect().position + event.position if btn != null else event.global_position
      on_release.call(card, release_pos)
  var card_rows = []
  for card in cards:
    var executable: bool = card.get("executable", true)
    var card_id := str(card.get("id", ""))
    var card_name := str(card.get("name", "蛊虫"))
    var is_active := str(interaction.get("card_id", "")) == card_id
    var body_style := MasterTheme.button_style("card")
    body_style["modulate"] = Color(1, 1, 1, 0.55) if not executable else Color(1, 1, 1, 1.0)
    if is_active:
      body_style["bg_color"] = GuStyle.PAPER_RAISED
      body_style["border_width_all"] = 2
      body_style["border_color"] = GuStyle.JADE
    card_rows.append(<Button name={ "card_body_" + card_id } text={ card_name } disabled={ false } ref={ func(n): card_nodes["current"][card_id] = n } onMouseEntered={ func(): on_hover.call(card) } onGuiInput={ func(event): handle_card_input.call(card, executable, card_id, event) } onPressed={ func(): if executable: on_press.call(card) } style={ body_style } />)
  if card_rows.is_empty():
    card_rows.append(<Label text="（无手牌）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
  var cancel_rows = []
  if str(interaction.get("mode", "idle")) == "target_select":
    cancel_rows.append(<GuButton label="取消目标" on_press={ on_cancel } />)
  return (<VBoxContainer style={ {"separation": 6} }><HBoxContainer style={ {"separation": 8} }>{ card_rows }</HBoxContainer>{ cancel_rows }</VBoxContainer>)
}
