{
  "id": "VERTICAL_DROPS_V0.1",
  "note": "四层掉落：GUARANTEED / WEIGHTED / CONDITIONAL / JACKPOT + Pity。每条掉落带 drop_target。",
  "layers": ["guaranteed", "weighted", "conditional", "jackpot"],
  "pity": {
    "enabled": true,
    "jackpotHardPity": 40,
    "buildComponentSoftPity": 12,
    "note": "防极端脸黑；关键配方件不得低于可形成路径的概率"
  },
  "dropTargets": {
    "STARTER": "一转月道起步者",
    "BUILD_COMPONENT": "正在准备某条炼制路线",
    "REFINEMENT": "要炼高转配方的人",
    "ECONOMIC": "缺元石/要卖钱",
    "UPKEEP": "供养/养蛊",
    "RECIPE": "要秘方的人",
    "JACKPOT": "改变构筑的高价值"
  },
  "enemyFamilyPools": {
    "beast_body": {
      "note": "野兽：身体材料、食材",
      "weighted": ["beast_fang", "meat", "bone"],
      "buildTarget": "STARTER"
    },
    "beast_armor": {
      "note": "重甲兽：破防材料",
      "weighted": ["iron_hide", "armor_chip"],
      "buildTarget": "REFINEMENT",
      "routeHint": "golden/antishield"
    },
    "wind_shadow": {
      "note": "月属异兽：月道材料+轨迹/闪避组件",
      "weighted": ["wind_fur", "moon_mat"],
      "buildTarget": "BUILD_COMPONENT",
      "routeHint": "moonspin/phantom"
    },
    "swarm": {
      "note": "虫群：群战测试对应 AOE 件",
      "weighted": ["bug_wing", "bug_core"],
      "buildTarget": "BUILD_COMPONENT",
      "routeHint": "aoe"
    },
    "ranged_gear": {
      "note": "弩修：远程/破甲",
      "weighted": ["bolt", "pierce_mat"],
      "buildTarget": "BUILD_COMPONENT",
      "routeHint": "moonmark"
    },
    "seal": {
      "note": "封蛊师：秘方/解封",
      "weighted": ["seal_talisman"],
      "buildTarget": "RECIPE"
    },
    "mana": {
      "note": "噬元：真元经济材料",
      "weighted": ["mana_sac"],
      "buildTarget": "ECONOMIC",
      "routeHint": "soul/suppress"
    },
    "herb": {
      "note": "妖植：食材/治疗",
      "weighted": ["vital_leaf"],
      "buildTarget": "UPKEEP"
    },
    "cultivator": {
      "note": "蛊师：元石、蛊虫、秘方碎片",
      "weighted": ["stone", "gu_shard"],
      "buildTarget": "JACKPOT",
      "special": "may_drop their own gu at low rate"
    },
    "boss": {
      "note": "强敌/Boss：稀有蛊、核心炼材",
      "guaranteed": ["stone_burst", "core_mat"],
      "buildTarget": "JACKPOT"
    }
  },
  "examples": [
    {
      "id": "E1R3_sample",
      "ref": "青背猎狼",
      "guaranteed": { "stone": [420, 620] },
      "weighted": [
        { "id": "green_wolf_tendon", "p": 0.5, "target": "REFINEMENT" },
        { "id": "wind_bone", "p": 0.3, "target": "BUILD_COMPONENT" },
        { "id": "r3_beast_mat", "p": 0.2, "target": "REFINEMENT" }
      ],
      "conditional": [
        { "when": "kill_with_curve", "bonus": { "id": "wind_bone", "n": 1 }, "target": "BUILD_COMPONENT" },
        { "when": "under_5_turns", "stoneBonusPct": 0.15, "target": "ECONOMIC" }
      ],
      "jackpot": [
        { "id": "whirlwind_gu", "p": 0.06, "target": "BUILD_COMPONENT" },
        { "id": "moon_spin_gu", "p": 0.012, "target": "JACKPOT" },
        { "id": "r3_wind_recipe_page", "p": 0.008, "target": "RECIPE" }
      ]
    },
    {
      "id": "r2_moon_beast_sample",
      "ref": "二转月属异兽（示例结构）",
      "guaranteed": { "stone": [40, 70] },
      "weighted": [{ "id": "moon_hua_shard", "p": 0.8, "n": [1, 2], "target": "REFINEMENT" }],
      "conditional": [
        { "when": "no_damage_kill", "bonus": { "id": "moon_hua_shard", "n": 1 } },
        { "when": "kill_with_moon", "weightBonus": { "r2_moon_mat": 0.2 } }
      ],
      "jackpot": [
        { "id": "small_light_gu", "p": 0.08, "target": "BUILD_COMPONENT" },
        { "id": "moon_mark_recipe_page", "p": 0.02, "target": "RECIPE" }
      ]
    }
  ],
  "bossFirstKill": {
    "guaranteed": ["refine_core_material"],
    "note": "Boss 首杀必掉炼蛊核心材料"
  },
  "formationCheck": "对每个 BUILD_COMPONENT 关键件：蒙特卡洛确认在合理场次内可形成；否则标 DROP_BLOCKED_ROUTE"
}
