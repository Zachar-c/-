{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gu-zhenren/world-model/world-model.schema.json",
  "title": "《蛊真人》肉鸽世界模型统一 Schema",
  "description": "world-model/data/ 下每个文件都是一个实体文档（envelope）。entity_type 决定 entities[] 逐项用哪个 $defs 定义校验。全部字段名为 ASCII；玩家可见文本字段以 _zh 结尾并保持 UTF-8 中文。draft-07 风格，但本仓库不依赖 jsonschema 包——实际校验由 world-model/schema/mini_schema.py 只用标准库完成。",
  "type": "object",
  "required": [
    "world_model_version",
    "schema_id",
    "schema_version",
    "entity_type",
    "generated_at",
    "generator",
    "source_refs",
    "count",
    "entities"
  ],
  "properties": {
    "world_model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "语义化版本，单一来源为 world-model/VERSION。"
    },
    "schema_id": {
      "type": "string",
      "const": "gu-zhenren/world-model"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entity_type": {
      "$ref": "#/$defs/entity_type"
    },
    "generated_at": {
      "type": "string",
      "description": "UTC ISO8601，由 tools/build_world_model.py 注入。"
    },
    "generator": {
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "只读上游表路径（相对仓库根）。"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "必须等于 entities 长度。"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "entity_type": {
      "type": "string",
      "enum": [
        "realm",
        "path",
        "gu",
        "economy",
        "faction",
        "region",
        "event",
        "loot",
        "balance",
        "manifest"
      ],
      "description": "8 类世界实体 + balance（集中参数）+ manifest（数据清单）。"
    },
    "source_class": {
      "type": "string",
      "enum": [
        "canon",
        "adaptation",
        "original_game_content"
      ],
      "description": "canon=原著事实；adaptation=兼容性游戏化；original_game_content=原创游戏内容。命名与 docs/lore/content-source-schema.md 一致。"
    },
    "canon_review_status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_source",
        "approved",
        "rejected"
      ],
      "description": "仅 approved 可进入可玩内容池。"
    },
    "traceability": {
      "type": "object",
      "required": [
        "source_class",
        "source_ids",
        "canon_review_status",
        "adaptation_note",
        "tunable"
      ],
      "properties": {
        "source_class": {
          "$ref": "#/$defs/source_class"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(CAN|ADP|GAME)-[A-Z0-9-]+$"
          },
          "description": "指向 CAN-/ADP-/GAME- 编号。"
        },
        "canon_review_status": {
          "$ref": "#/$defs/canon_review_status"
        },
        "adaptation_note": {
          "type": "string",
          "description": "source_class=adaptation 时必填说明；其余可为空字符串。"
        },
        "tunable": {
          "type": "boolean",
          "description": "true = 允许通过 balance.json / 本字段调参而不改变世界规则。"
        }
      },
      "additionalProperties": true
    },
    "epoch_iso8601": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z?$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "realm": {
      "title": "境界",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "rank",
        "stage",
        "cultivator_class",
        "energy_type",
        "cultivation_factor",
        "in_launch_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r[1-9]_(initial|middle|upper|peak)$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "stage": {
          "type": "string",
          "enum": [
            "initial",
            "middle",
            "upper",
            "peak"
          ]
        },
        "cultivator_class": {
          "type": "string",
          "enum": [
            "gu_master",
            "gu_immortal"
          ]
        },
        "honorific": {
          "type": "string",
          "enum": [
            "",
            "venerable"
          ]
        },
        "energy_type": {
          "type": "string",
          "enum": [
            "primeval_essence",
            "immortal_essence"
          ]
        },
        "essence_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "bronze",
            "iron",
            "silver",
            "gold",
            "amethyst",
            null
          ]
        },
        "essence_tier_zh": {
          "type": [
            "string",
            "null"
          ]
        },
        "essence_tier_note": {
          "type": "string"
        },
        "cultivation_factor": {
          "type": "integer",
          "minimum": 1
        },
        "essence_max_battle_base": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "load_capacity": {
          "type": "number",
          "minimum": 0
        },
        "thought_capacity_base": {
          "type": "integer",
          "minimum": 0
        },
        "in_launch_scope": {
          "type": "boolean"
        },
        "is_immortal_tier": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "path": {
      "title": "道途 / 流派",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "dao_tags",
        "starter_gu_ids",
        "pool_gu_ids",
        "pool_size",
        "cross_school_penalty_per_extra"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary_zh": {
          "type": "string"
        },
        "dao_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "开放集合；不是封闭流派枚举。"
        },
        "starter_gu_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "pool_gu_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pool_size": {
          "type": "integer",
          "minimum": 0
        },
        "pool_ranks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "conflict_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_school_penalty_per_extra": {
          "type": "number",
          "minimum": 0
        },
        "cross_school_exclusion_penalty": {
          "type": "number",
          "minimum": 0
        },
        "material_resonance": {
          "type": "integer",
          "minimum": 0
        },
        "is_open_set": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "gu": {
      "title": "蛊虫",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "rank",
        "rarity",
        "school",
        "role",
        "value",
        "activation_cost",
        "feeding",
        "effect",
        "effect_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name_zh": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99,
          "description": "1–9 为正式转数；>9 仅存在于 is_test_entity=true 的调试实体。"
        },
        "rarity": {
          "type": "string",
          "enum": [
            "common",
            "rare",
            "epic",
            "legendary"
          ]
        },
        "school": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "attack",
            "defense",
            "support",
            "movement",
            "healing",
            "recon",
            "logistics"
          ]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activation_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "activation_cost_source": {
          "type": "string",
          "enum": [
            "true_qi_cost",
            "essence_cost",
            "default"
          ]
        },
        "feeding": {
          "type": "object",
          "required": [
            "stone_per_stage",
            "feed_points_per_stage"
          ],
          "properties": {
            "stone_per_stage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "feed_points_per_stage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "additionalProperties": false
        },
        "effect": {
          "type": "object",
          "description": "kind=strike/heal/shield/shift/status/heal_and_strike/composite/none 之一；composite 带 parts[]。"
        },
        "effect_source": {
          "type": "string",
          "enum": [
            "explicit",
            "combat_effects",
            "role_default"
          ],
          "description": "explicit=有独立 v1_effect；combat_effects=仅组合效果；role_default=按角色兜底，不代表独立效果。"
        },
        "combat_key": {
          "type": "string"
        },
        "low_rank_exception": {
          "type": "boolean"
        },
        "sword_mark_cost": {
          "type": "boolean"
        },
        "life_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "is_test_entity": {
          "type": "boolean"
        },
        "in_launch_scope": {
          "type": "boolean"
        },
        "prototype_source": {
          "type": "string",
          "enum": [
            "",
            "novel",
            "school_derived"
          ]
        },
        "refine_as_output": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe_edge"
          }
        },
        "refine_as_input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shop_offer_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drop_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(common|elite|boss):(common|rare|epic)$"
          }
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "is_test_entity": {
              "const": false
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          }
        },
        {
          "properties": {
            "is_test_entity": {
              "const": true
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        }
      ]
    },
    "recipe_edge": {
      "type": "object",
      "required": [
        "recipe_id",
        "kind",
        "input_gu_ids",
        "materials",
        "stone_cost",
        "output_gu_id"
      ],
      "properties": {
        "recipe_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "advance",
            "fixed",
            "free_mix",
            "promotion"
          ]
        },
        "materials": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          }
        },
        "stone_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "output_gu_id": {
          "type": "string"
        },
        "output_rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9
        },
        "default_unlocked": {
          "type": "boolean"
        },
        "input_gu_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "economy": {
      "title": "资源与经济",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "resources",
        "price_anchors",
        "layer_budget",
        "black_market_exchange"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name_zh": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "mortal_run",
            "immortal_tier"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "price_anchors": {
          "type": "object"
        },
        "battle_stone_rewards": {
          "type": "object"
        },
        "layer_budget": {
          "type": "object"
        },
        "inflation": {
          "type": "object"
        },
        "black_market_exchange": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exchange_rate"
          }
        },
        "shop_offer_histogram": {
          "type": "object"
        },
        "material_reference_prices": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "shop_offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shop_offer"
          }
        }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "unit",
        "channels_in",
        "channels_out",
        "tunable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "name_zh": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "start_value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hard_cap": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "channels_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "channels_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_launch_scope": {
          "type": "boolean"
        },
        "tunable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "exchange_rate": {
      "type": "object",
      "required": [
        "from",
        "amount_in",
        "to",
        "amount_out"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "amount_in": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "string"
        },
        "amount_out": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "faction": {
      "title": "势力与关系",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "entity_kind",
        "relation_levels",
        "route_effects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "name_zh": {
          "type": "string"
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "faction",
            "global_axis"
          ]
        },
        "summary_zh": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relation_levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/relation_level"
          }
        },
        "route_effects": {
          "type": "object"
        },
        "trade_effects": {
          "type": "object"
        },
        "pursuit_effects": {
          "type": "object"
        },
        "notoriety": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "relation_level": {
      "type": "object",
      "required": [
        "id",
        "label_zh",
        "min_points",
        "max_points",
        "price_pct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "hostile",
            "cold",
            "neutral",
            "warm",
            "honored"
          ]
        },
        "label_zh": {
          "type": "string"
        },
        "min_points": {
          "type": "integer",
          "minimum": -999,
          "maximum": 999
        },
        "max_points": {
          "type": "integer",
          "minimum": -999,
          "maximum": 999
        },
        "price_pct": {
          "type": "number",
          "minimum": -100,
          "maximum": 200
        },
        "hostile_chance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "first_move_chance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "region": {
      "title": "地域与关卡",
      "allOf": [
        {
          "$ref": "#/$defs/traceability"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name_zh",
        "entity_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name_zh": {
          "type": "string"
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "macro_region",
            "layer",
            "special_stage"
          ]
        },
        "layer": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "rows_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "rows_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "row_nodes_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "row_nodes_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "category_weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "category_weight_sum": {
          "type": "number",
          "minimum": 1
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "stage_node_templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boss_seat": {
          "type": [
            "string",
            "null"
          ]
        },
        "boss_pool": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enemy_pool": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enemy_rank_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "enemy_rank_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "stone_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "shop_price_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "shop_max_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "npc_roster": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/npc"
          }
        },
        "node_templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node_template"
          }
        },
        "enemy_roster": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enemy"
          }
        },
        "template_pools": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
