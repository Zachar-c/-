    "allow_projection": ["HP", "Thought", "combat_pacing", "qi_mapping", "reward_scale", "enemy_HP", "turn_window", "experimental_price"],
    "c3_note": "月芒 canonical=月光+小光×2 不得用 pacing_projection 改成 ×1"
  },
  "q4_counter": {
    "decision": "primitive_only_not_skeleton",
    "owns": ["Intent", "Observe", "KnownCounter", "Read", "Act", "short_cycle_counter"],
    "not_owns": ["qi_economy", "distance", "gu_composition", "kill_move_structure", "wound", "blood", "stealth", "body", "soul", "poison", "environment", "long_status", "economy", "refinement", "enemy_full_build"],
    "admission_gates": ["UNIQUE", "BUILD_RELEVANT", "COUNTERPLAY", "STATEFUL", "TESTABLE", "SOURCE"]
  },
  "q5_rank_runtime": {
    "fields": [
      "rank",
      "essence_tier",
      "gu_rank_cap",
      "cross_rank_cost_curve",
      "killer_move_complexity_cap",
      "refinement_rank_cap",
      "maintenance_capacity",
      "progression_access_tier"
    ],
    "allow_rank_multiplier_on": [],
    "low_rank_keep_policy": "有 0.65^(rank差) 成本折算则不再加价值折损",
    "complexity": "stable_complexity_cap + 超出用代价支付；第一版只用 complexity_points"
  },
  "q6_order": ["Projection", "Rank", "Economy", "KillMoveChecker", "CounterBoundary"],
  "l2_may_implement": [
    "Projection schema/validator",
    "Rank字段接线（不改玩家行为）",
    "经济 check_balance 门禁",
