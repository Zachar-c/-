{
  "ruling_id": "RUL-2026-09-21-010",
  "title_zh": "L1 代码漂移与纵向体系接通（Q1–Q6 + C3/C6）",
  "date": "2026-09-21",
  "authority": "L1",
  "supersedes": null,
  "principle": "Integration First · 先关系、再门禁、后迁移行为",
  "phase_order": [
    "PHASE1 Projection validator",
    "PHASE2 Rank runtime wiring",
    "PHASE3 Purchasing-power checks",
    "PHASE4 Kill-move composition checker (B)",
    "PHASE5 Counter boundary tests"
  ],
  "q1_kill_move": {
    "decision": "B_gradual",
    "now": "保留 declared damage / true_qi_cost",
    "add": "组件贡献校验 expected=Σcomponent×coordination，±15% 或 override_reason",
    "later": "逐条迁移为组件推导",
    "forbid": ["一次重写26杀招", "方案A全量运行时推导"],
    "coordination_range": [0.85, 1.15],
    "coordination_manual_band": [0.75, 1.25],
    "roles": ["core", "amplifier", "transform", "support", "condition", "resource"],
    "forbid_pp_sum_as_damage": true
  },
  "q2_economy": {
    "decision": "four_axes_independent",
    "axes": ["IncomeCurve", "PriceCurve", "RefinementLossCurve", "BreakthroughCurve"],
    "unit": "I_r = 同转普通战平均元石净收入（场次制门禁）",
    "gates_fights_of_I": {
      "1": { "gu_price": [1.5, 2.5], "refine_fail_loss": [0.5, 1.0], "breakthrough_stone": [2, 3] },
      "2": { "gu_price": [2.0, 3.0], "refine_fail_loss": [0.75, 1.25], "breakthrough_stone": [3, 5] },
      "3": { "gu_price": [2.5, 3.5], "refine_fail_loss": [1.0, 1.75], "breakthrough_stone": [5, 8] },
      "4": { "gu_price": [3.0, 4.5], "refine_fail_loss": [1.5, 2.5], "breakthrough_stone": [8, 12] },
      "5": { "gu_price": [4.0, 6.0], "refine_fail_loss": [2.0, 3.5], "breakthrough_stone": null }
    },
    "enforcement": "TOO_CHEAP / TOO_EXPENSIVE 报警，不自动改价",
    "rank_multiplier_scope": ["budget_anchor", "material_convert", "feeding_value", "historical_compat"],
    "forbid": "rank_multiplier 作为经济总函数"
  },
  "q3_projection": {
    "required_fields": ["id", "childKey", "value", "parents", "policy", "scope", "rationale", "authority", "validation", "forbidWriteBack"],
    "parents_is_array": true,
    "forbid_projection": [
      "entity_id",
      "rank",
      "dao",
      "canonical_refinement_composition",
      "canonical_lore_facts",
      "provenance",
      "frozen_ruling_semantics"
