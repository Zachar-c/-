{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://gu-zhenren.local/schemas/wenzhen-asset-manifest.schema.json", "title": "Wenzhen Asset Manifest", "description": "Authorizes non-commercial use of externally sourced assets shipped with the build.", "type": "object", "required": ["schema_version", "usage_notice", "assets"], "additionalProperties": false, "properties": {"schema_version": {"type": "integer", "minimum": 1}, "usage_notice": {"type": "string", "minLength": 1}, "assets": {"type": "array", "items": {"type": "object", "required": ["id", "path", "kind", "source", "license", "author", "facing"], "additionalProperties": true, "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "path": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "author": {"type": "string", "minLength": 1}, "facing": {"type": "string", "minLength": 1}, "watermark": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}}}}