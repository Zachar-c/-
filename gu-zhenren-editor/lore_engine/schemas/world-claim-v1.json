{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Model Stage 0 ledger record",
  "oneOf": [
    {"$ref":"#/$defs/claim"}, {"$ref":"#/$defs/evidence"},
    {"$ref":"#/$defs/finding"}, {"$ref":"#/$defs/decision"}
  ],
  "$defs": {
    "claim": {"type":"object","additionalProperties":false,"required":["claim_id","topic","statement","status","impact","source_ids","evidence_ids","counter_evidence_ids","confidence"],"properties":{"claim_id":{"type":"string","minLength":1},"topic":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"status":{"enum":["candidate","canonical","derived","adaptation","rejected","deferred"]},"previous_status":{"enum":["candidate","canonical","derived","adaptation","rejected","deferred"]},"impact":{"enum":["high","medium","low"]},"source_ids":{"type":"array","items":{"type":"string","minLength":1}},"evidence_ids":{"type":"array","items":{"type":"string","minLength":1}},"counter_evidence_ids":{"type":"array","items":{"type":"string","minLength":1}},"confidence":{"enum":["high","medium","low","unknown"]}}},
    "evidence": {"type":"object","additionalProperties":false,"required":["evidence_id","source_file_id","source_ref","char_start","char_end","quote","authority","evidence_kind"],"properties":{"evidence_id":{"type":"string","minLength":1},"source_file_id":{"type":"string","minLength":1},"source_ref":{"type":"string","minLength":1},"char_start":{"type":"integer"},"char_end":{"type":"integer"},"quote":{"type":"string"},"authority":{"enum":["primary_text","in_world_text","secondary_note","code","design"]},"evidence_kind":{"enum":["support","condition","counterexample","unknown"]}},"anyOf":[{"properties":{"evidence_kind":{"const":"unknown"},"char_start":{"const":-1},"char_end":{"const":-1},"quote":{"const":""}}},{"properties":{"evidence_kind":{"enum":["support","condition","counterexample"]},"char_start":{"minimum":0},"char_end":{"minimum":1},"quote":{"minLength":1}}}],"x-repository-constraints":["char_end_gt_char_start"]},
    "finding": {"type":"object","additionalProperties":false,"required":["finding_id","claim_id","path","locator","observed","source_layer","behavior_status","migration_action"],"properties":{"finding_id":{"type":"string","minLength":1},"claim_id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"observed":{"type":"string","minLength":1},"source_layer":{"enum":["data","domain","presentation","spec"]},"behavior_status":{"enum":["aligned","partial","conflict","unknown","not_implemented"]},"migration_action":{"enum":["retain","revise","remove","defer"]}}},
    "decision": {"type":"object","additionalProperties":false,"required":["claim_id","ruling","rationale","player_consequence","implementation_action","non_regression_notes"],"properties":{"claim_id":{"type":"string","minLength":1},"decision_kind":{"enum":["preliminary","final"]},"ruling":{"enum":["retain","revise","remove","defer","needs_evidence"]},"rationale":{"type":"string","minLength":1},"player_consequence":{"type":"string","minLength":1},"implementation_action":{"type":"string","minLength":1},"non_regression_notes":{"type":"array","items":{"type":"string","minLength":1}},"previous_status":{"enum":["candidate","canonical","derived","adaptation","rejected","deferred"]}}}
  }
}
