
# GuCard —— 卡牌容器（规格 §9，2026-08-26-ui-sts-redesign-design）
# 品质色轨 / 代价圆标 / 危险「咒」角标（DANGER 底 BONE 字，左上首位）/ 封印「锁」态 / 圆角描边。
# props（全部可选，向后兼容）：title / highlight / danger / quality / cost / curse_warning / sealed
# interaction_mode / disabled / selected 只表达宿主的本地交互反馈；卡牌不拥有战斗 FSM。

export GuCard() -> RuitkVNode {
  var title = props.get("title", "")
  var highlight = props.get("highlight", false)
  var danger = props.get("danger", false)
  var quality = props.get("quality", "")
  var cost = props.get("cost", "")
  var curse_warning = props.get("curse_warning", false)
  var sealed = props.get("sealed", false)
  var interaction_mode = str(props.get("interaction_mode", "idle"))
  var disabled = (props.get("disabled", false))
  var selected = (props.get("selected", false))

  var QUAL_COLORS = {"普通": GuStyle.INK_SOFT, "稀有": GuStyle.ANOMALY_YELLOW, "史诗": GuStyle.RARITY_EPIC, "传说": GuStyle.RARITY_LEGENDARY, "common": GuStyle.INK_SOFT, "rare": GuStyle.ANOMALY_YELLOW, "epic": GuStyle.RARITY_EPIC, "legendary": GuStyle.RARITY_LEGENDARY}
  var quality_color = QUAL_COLORS.get(quality, GuStyle.INK_SOFT)
  var is_danger = danger or curse_warning
  var border_color = GuStyle.CINNABAR if is_danger else (GuStyle.JADE if highlight or selected else (quality_color if quality != "" else GuStyle.INK_SOFT))
  var card_style = {
    # PAPER_DEEP 是禁用层 token，不做卡牌底色；层级靠 1px 发丝线与留白表达。
    "bg_color": GuStyle.PAPER_BG,
    "corner_radius_all": 8,
    "border_width_all": 2 if is_danger else 1,
    "border_color": border_color,
    "size_flags_horizontal": 3,
  }
  if sealed:
    card_style["modulate"] = Color(1, 1, 1, 0.55)
  elif disabled:
    card_style["modulate"] = Color(1, 1, 1, 0.55)
  elif interaction_mode == "dragging":
    card_style["modulate"] = Color(1, 1, 1, 0.82)

  return (
    <PanelContainer style={ card_style }>
      <MarginContainer style={ {"margin_left": 12, "margin_right": 12, "margin_top": 10, "margin_bottom": 10} }>
        <VBoxContainer style={ {"separation": 6} }>
          <HBoxContainer style={ {"separation": 8} }>
            @if (curse_warning) {
              return (
                <PanelContainer style={ {"bg_color": GuStyle.CINNABAR, "corner_radius_all": 4} }>
                  <MarginContainer style={ {"margin_left": 5, "margin_right": 5, "margin_top": 1, "margin_bottom": 1} }>
                    <Label text="咒" style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 12} } />
                  </MarginContainer>
                </PanelContainer>
              )
            }
            @if (sealed) {
              return (
                <PanelContainer style={ {"bg_color": GuStyle.PAPER_RAISED, "corner_radius_all": 4, "border_width_all": 1, "border_color": GuStyle.INK_SOFT} }>
                  <MarginContainer style={ {"margin_left": 5, "margin_right": 5, "margin_top": 1, "margin_bottom": 1} }>
                    <Label text="锁" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
                  </MarginContainer>
                </PanelContainer>
              )
            }
            @if (title != "") {
              return ( <Label text={ title } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 16} } /> )
            }
            @if (quality != "") {
              return ( <Label text={ quality } style={ {"font_color": quality_color, "font_size": 12} } /> )
            }
          </HBoxContainer>
          { children }
          @if (cost != "") {
            return ( <Label text={ "◆ " + cost } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } /> )
          }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
