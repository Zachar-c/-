@theme "res://assets/theme/gu_theme.tres"

# GuCard —— 卡牌容器（规格 §9，2026-08-26-ui-sts-redesign-design）
# 品质色轨 / 代价圆标 / 危险「咒」角标（DANGER 底 BONE 字，左上首位）/ 封印「锁」态 / 圆角描边。
# props（全部可选，向后兼容）：title / highlight / danger / quality / cost / curse_warning / sealed

export GuCard() -> RuitkVNode {
  var title = props.get("title", "")
  var highlight = props.get("highlight", false)
  var danger = props.get("danger", false)
  var quality = props.get("quality", "")
  var cost = props.get("cost", "")
  var curse_warning = props.get("curse_warning", false)
  var sealed = props.get("sealed", false)
  var expand_h = props.get("expand_h", false)

  var QUAL_COLORS = {"普通": GuStyle.BONE_DIM, "稀有": GuStyle.GOLD, "史诗": GuStyle.EMBER, "传说": GuStyle.PAPER, "common": GuStyle.BONE_DIM, "rare": GuStyle.GOLD, "epic": GuStyle.EMBER, "legendary": GuStyle.PAPER}
  var quality_color = QUAL_COLORS.get(quality, GuStyle.BONE_DIM)
  var is_danger = danger or curse_warning
  var border_color = GuStyle.DANGER if is_danger else (GuStyle.JADE_BRIGHT if highlight else (quality_color if quality != "" else GuStyle.GOLD_DIM))
  var card_style = {
    "bg_color": GuStyle.BG_RAISED,
    "corner_radius_all": 10,
    "border_width_all": 2 if is_danger else 1,
    "border_color": border_color,
  }
  if sealed:
    card_style["modulate"] = Color(1, 1, 1, 0.55)
  if expand_h:
    card_style["size_flags_horizontal"] = 3

  return (
    <PanelContainer style={ card_style }>
      <MarginContainer style={ {"margin_left": 12, "margin_right": 12, "margin_top": 10, "margin_bottom": 10} }>
        <VBoxContainer style={ {"separation": 6} }>
          <HBoxContainer style={ {"separation": 8} }>
            @if (curse_warning) {
              return (
                <PanelContainer style={ {"bg_color": GuStyle.DANGER, "corner_radius_all": 4} }>
                  <MarginContainer style={ {"margin_left": 5, "margin_right": 5, "margin_top": 1, "margin_bottom": 1} }>
                    <Label text="咒" style={ {"font_color": GuStyle.BONE, "font_size": 12} } />
                  </MarginContainer>
                </PanelContainer>
              )
            }
            @if (sealed) {
              return (
                <PanelContainer style={ {"bg_color": GuStyle.BG_PANEL, "corner_radius_all": 4, "border_width_all": 1, "border_color": GuStyle.GOLD_DIM} }>
                  <MarginContainer style={ {"margin_left": 5, "margin_right": 5, "margin_top": 1, "margin_bottom": 1} }>
                    <Label text="锁" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 12} } />
                  </MarginContainer>
                </PanelContainer>
              )
            }
            @if (title != "") {
              return ( <Label text={ title } style={ {"font_color": GuStyle.BONE, "font_size": 16} } /> )
            }
            @if (quality != "") {
              return ( <Label text={ quality } style={ {"font_color": quality_color, "font_size": 12} } /> )
            }
          </HBoxContainer>
          { children }
          @if (cost != "") {
            return ( <Label text={ "◆ " + cost } style={ {"font_color": GuStyle.GOLD, "font_size": 13} } /> )
          }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
