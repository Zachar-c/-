@theme "res://assets/theme/gu_theme.tres"

export GuTooltipView() -> RuitkVNode {
  var title = props.get("title", "")
  var quality = props.get("quality", "")
  var effect = props.get("effect", "")
  var synergy = props.get("synergy", "")
  var cost = props.get("cost", "")
  var curse_warning = props.get("curse_warning", false)
  var on_detail = props.get("on_detail", null)
  return (
    <PanelContainer>
      <MarginContainer style={ {"margin_left": 10, "margin_right": 10, "margin_top": 10, "margin_bottom": 10} }>
        <VBoxContainer style={ {"separation": 4} }>
          @if (title != "") {
            return ( <Label text={ title } style={ {"font_color": GuStyle.GOLD, "font_size": 16} } /> )
          }
          @if (quality != "") {
            return ( <Label text={ "品质: %s" % quality } style={ {"font_color": GuStyle.JADE, "font_size": 14} } /> )
          }
          @if (effect != "") {
            return ( <Label text={ "效果: %s" % effect } style={ {"font_color": GuStyle.BONE, "font_size": 14} } /> )
          }
          @if (synergy != "") {
            return ( <Label text={ "联动: %s" % synergy } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } /> )
          }
          @if (cost != "") {
            return ( <Label text={ "代价: %s" % cost } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } /> )
          }
          @if (curse_warning) {
            return ( <Label text="诅咒警示" style={ {"font_color": GuStyle.DANGER, "font_size": 14} } /> )
          }
          @if (on_detail != null) {
            return ( <Button text="?" onPressed={ func(): on_detail.call() } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14, "min_width": 24, "min_height": 24} } /> )
          }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
