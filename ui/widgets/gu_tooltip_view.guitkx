@theme "res://assets/theme/gu_theme.tres"

# GuTooltipView —— 统一 tooltip 模板（规格 §9 / §16.5）
# 固定格式：品质 / 效果 / 联动 / 代价 / 诅咒警示；宣纸底卷轴感。
# props：title / quality / effect / synergy / cost / curse_warning / on_detail

export GuTooltipView() -> RuitkVNode {
  var title = props.get("title", "")
  var quality = props.get("quality", "")
  var effect = props.get("effect", "")
  var synergy = props.get("synergy", "")
  var cost = props.get("cost", "")
  var curse_warning = props.get("curse_warning", false)
  var on_detail = props.get("on_detail", null)

  var QUAL_COLORS = {"普通": GuStyle.BONE_DIM, "稀有": GuStyle.GOLD, "史诗": GuStyle.EMBER, "传说": GuStyle.PAPER}
  var quality_color = QUAL_COLORS.get(quality, GuStyle.BONE_DIM)

  return (
    <PanelContainer style={ {"bg_color": Color(0.16, 0.15, 0.12, 0.96), "corner_radius_all": 6, "border_width_all": 1, "border_color": GuStyle.PAPER_DIM} }>
      <MarginContainer style={ {"margin_left": 12, "margin_right": 12, "margin_top": 10, "margin_bottom": 10} }>
        <VBoxContainer style={ {"separation": 4} }>
          <HBoxContainer style={ {"separation": 8} }>
            @if (title != "") {
              return ( <Label text={ title } style={ {"font_color": GuStyle.GOLD, "font_size": 16} } /> )
            }
            @if (quality != "") {
              return ( <Label text={ quality } style={ {"font_color": quality_color, "font_size": 12} } /> )
            }
          </HBoxContainer>
          @if (effect != "") {
            return ( <Label text={ "效果：" + effect } style={ {"font_color": GuStyle.BONE, "font_size": 14} } /> )
          }
          @if (synergy != "") {
            return ( <Label text={ "联动：" + synergy } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } /> )
          }
          @if (cost != "") {
            return ( <Label text={ "代价：" + cost } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } /> )
          }
          @if (curse_warning) {
            return ( <Label text={ "诅咒警示：" + effect } style={ {"font_color": GuStyle.DANGER, "font_size": 14} } /> )
          }
          @if (on_detail != null) {
            return ( <Button text="详情" onPressed={ func(): on_detail.call() } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14, "min_width": 24, "min_height": 24} } /> )
          }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
