
# GuDeathLineWarning —— 三死线预警（规格 §9 / §16.10 死亡可预见 / D2 强化）
# 危险行：「☠」前缀 + 加大字号（15 = 基础 13 + 2）+ 半透明血锈底条，
# 整行可点击（仅 danger 行，且宿主接线 on_view 时）→ 打开死因查看浮层。
# 安全行：BONE_DIM 常规「·」前缀，不可点。
# 静态样式，无任何循环/常驻动画（规格 §3.4 动效预算）。
# props：death_lines{kind:{name,remaining,max,danger,cause_id}} / on_view(cause_id)

export GuDeathLineWarning() -> RuitkVNode {
  var death_lines = props.get("death_lines", {})
  var on_view = props.get("on_view", null)
  var blood_bar = Color(0.55, 0.18, 0.15, 0.25)
  var bar_box = {"bg_color": blood_bar, "corner_radius_all": 4,
    "content_margin_left": 6, "content_margin_right": 6,
    "content_margin_top": 2, "content_margin_bottom": 2}

  var rows = []
  for kind in death_lines.keys():
    var d = death_lines[kind]
    var nm = str(d.get("name", kind))
    var remaining = int(d.get("remaining", 0))
    var maxv = int(d.get("max", 0))
    var danger = bool(d.get("danger", false))
    var cause_id = str(d.get("cause_id", ""))
    if danger:
      var text = "☠ %s %d/%d" % [nm, remaining, maxv]
      var font_style = {"font_color": GuStyle.CINNABAR, "font_size": 15}
      if on_view != null:
        var row_style = {}
        for k in bar_box:
          row_style[k] = bar_box[k]
        for k in font_style:
          row_style[k] = font_style[k]
        rows.append(V.Button({"text": text, "alignment": 0, "onPressed": func(): on_view.call(cause_id), "style": row_style}))
      else:
        rows.append(V.PanelContainer(bar_box, [V.Label({"text": text, "style": font_style})]))
    else:
      var text = "· %s %d/%d" % [nm, remaining, maxv]
      rows.append(V.Label({"text": text, "style": {"font_color": GuStyle.INK_SOFT, "font_size": 13}}))

  return (
    <VBoxContainer style={ {"separation": 4} }>
      <Label text="三死线" style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 13} } />
      { rows }
    </VBoxContainer>
  )
}
