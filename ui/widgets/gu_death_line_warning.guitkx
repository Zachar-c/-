@theme "res://assets/theme/gu_theme.tres"

export GuDeathLineWarning() -> RuitkVNode {
  var lines = props.get("lines", [])
  var on_view = props.get("on_view", null)
  var triggered = []
  for ln in lines:
    if int(ln.get("value", 0)) >= int(ln.get("threshold", 0)):
      triggered.append(ln)
  var rows = []
  for ln in triggered:
    var row_children = [V.Label({"text": "⚠ %s 逼近上限" % ln.get("name", ""), "style": {"font_color": GuStyle.DANGER, "font_size": 13}})]
    if on_view != null:
      row_children.append(V.Button({"text": "?", "flat": true, "onPressed": func(): on_view.call(), "style": {"font_color": GuStyle.DANGER, "font_size": 13, "min_width": 22, "min_height": 22}}))
    rows.append(V.HBoxContainer({"separation": 4}, row_children))
  return ( <HBoxContainer style={ {"separation": 6} }>{ rows }</HBoxContainer> )
}
