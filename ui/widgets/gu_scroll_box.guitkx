
# GuScrollBox —— 滚动容器（规格 §9）
# 无自身纸面（面板已提供纸面，再套一层会造成明暗倒挂）。
# props：height —— <=0 时纵向扩张填满父容器（默认），>0 时保留固定高度。

export GuScrollBox() -> RuitkVNode {
  var height = int(props.get("height", 0))
  var box_style = {"bg_color": Color(0, 0, 0, 0), "corner_radius_all": 0, "border_width_all": 0}
  var scroll_style = {"size_flags_horizontal": 3}
  if height <= 0:
    box_style["size_flags_vertical"] = 3
    scroll_style["size_flags_vertical"] = 3
  else:
    scroll_style["min_height"] = height
  return (
    <PanelContainer style={ box_style }>
      <ScrollContainer style={ scroll_style }>
        <MarginContainer style={ {"margin_left": 8, "margin_right": 8, "margin_top": 8, "margin_bottom": 8, "size_flags_horizontal": 3} }>
          <VBoxContainer style={ {"separation": 6} }>
            { children }
          </VBoxContainer>
        </MarginContainer>
      </ScrollContainer>
    </PanelContainer>
  )
}
