@theme "res://assets/theme/gu_theme.tres"

# GuButton —— 主/次/危险按钮（問眞极简视觉）
# props：label / disabled / danger / on_press / size("normal"|"large")

export GuButton() -> RuitkVNode {
  var label = props.get("label", "按钮")
  var disabled = props.get("disabled", false)
  var danger = props.get("danger", false)
  var on_press = props.get("on_press", func(): pass)
  var size = props.get("size", "normal")

  var fg = GuStyle.CINNABAR if danger else GuStyle.INK_PRIMARY
  var border = GuStyle.CINNABAR if danger else GuStyle.HAIRLINE_COLOR
  var min_h = 44 if size == "large" else 32
  var font_size = 16 if size == "large" else 14

  var style = {
    "font_color": fg,
    "min_width": 120,
    "min_height": min_h,
    "font_size": font_size,
    "bg_color": GuStyle.PAPER_RAISED,
    "corner_radius_all": GuStyle.RADIUS_SMALL,
    "border_width_all": GuStyle.HAIRLINE,
    "border_color": border,
  }

  return (
    <Button
      text={ label }
      disabled={ disabled }
      onPressed={ func(): on_press.call() }
      style={ style }
    />
  )
}
