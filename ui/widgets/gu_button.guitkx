
# GuButton —— 主/次/危险按钮（問眞极简视觉）
# props：label / disabled / danger / role / on_press / size("normal"|"large")

export GuButton() -> RuitkVNode {
  var label = props.get("label", "按钮")
  var disabled = props.get("disabled", false)
  var danger = props.get("danger", false)
  var role = str(props.get("role", "danger" if danger else "action"))
  var on_press = props.get("on_press", func(): pass)
  var size = props.get("size", "normal")

  var theme_script = preload("res://scripts/presentation/wenzhen_master_theme.gd")
  var style = theme_script.button_style(role, size)

  return (
    <Button
      text={ label }
      disabled={ disabled }
      onPressed={ func(): on_press.call() }
      style={ style }
    />
  )
}
