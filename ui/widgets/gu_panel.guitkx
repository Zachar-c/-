@theme "res://assets/theme/gu_theme.tres"

export GuPanel() -> RuitkVNode {
  var title = props.get("title", "")
  var expand_h = props.get("expand_h", false)
  var expand_v = props.get("expand_v", false)
  var root_style = {}
  if expand_h:
    root_style["size_flags_horizontal"] = 3
  if expand_v:
    root_style["size_flags_vertical"] = 3
  return (
    <PanelContainer style={ root_style }>
      <MarginContainer style={ {"margin_left": 12, "margin_right": 12, "margin_top": 12, "margin_bottom": 12} }>
        <VBoxContainer style={ {"separation": 8} }>
          @if (title != "") {
            return ( <Label text={ title } style={ {"font_color": GuStyle.GOLD, "font_size": 18} } /> )
          }
          { children }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
