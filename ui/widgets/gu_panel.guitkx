
# GuPanel —— 内容边界容器（問眞极简视觉）
# 仅提供发丝线边界与留白，无阴影、无厚边框、无嵌套卡片。

export GuPanel() -> RuitkVNode {
  var title = props.get("title", "")
  var expand_h = props.get("expand_h", false)
  var expand_v = props.get("expand_v", false)
  var root_style = {}
  if expand_h:
    root_style["size_flags_horizontal"] = 3
  if expand_v:
    root_style["size_flags_vertical"] = 3
  return (
    <PanelContainer style={ root_style }>
      <MarginContainer style={ {"margin_left": GuStyle.SPACE_3, "margin_right": GuStyle.SPACE_3, "margin_top": GuStyle.SPACE_3, "margin_bottom": GuStyle.SPACE_3} }>
        <VBoxContainer style={ {"separation": GuStyle.SPACE_2} }>
          @if (title != "") {
            return ( <Label text={ title } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 18} } /> )
          }
          { children }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
