@theme "res://assets/theme/gu_theme.tres"

export GuConfirmDialog() -> RuitkVNode {
  var message = props.get("message", "")
  var confirm_label = props.get("confirm_label", "确认")
  var cancel_label = props.get("cancel_label", "取消")
  var on_confirm = props.get("on_confirm", func(): pass)
  var on_cancel = props.get("on_cancel", func(): pass)
  return (
    <PanelContainer>
      <MarginContainer style={ {"margin_left": 16, "margin_right": 16, "margin_top": 16, "margin_bottom": 16} }>
        <VBoxContainer style={ {"separation": 12} }>
          <Label text={ message } style={ {"font_color": GuStyle.BONE, "font_size": 16} } />
          <HBoxContainer style={ {"separation": 12} }>
            <Button text={ cancel_label } onPressed={ func(): on_cancel.call() } style={ {"font_color": GuStyle.BONE_DIM, "min_width": 120, "min_height": 36} } />
            <Button text={ confirm_label } onPressed={ func(): on_confirm.call() } style={ {"font_color": GuStyle.DANGER, "min_width": 120, "min_height": 36} } />
          </HBoxContainer>
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
