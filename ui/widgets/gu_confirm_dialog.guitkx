
# GuConfirmDialog —— 统一确认弹窗（规格 §9 / D1 弹窗族六场景）
# 顶部 DANGER 警示条 + 后果预览；危险色锁死。
# props：message / confirm_label / cancel_label / on_confirm / on_cancel
#        title（可选，警示条标题，默认「⚠ 确认」）/ warning_note（可选第二行后果预览小字）

export GuConfirmDialog() -> RuitkVNode {
  var message = props.get("message", "")
  var confirm_label = props.get("confirm_label", "确认")
  var cancel_label = props.get("cancel_label", "取消")
  var on_confirm = props.get("on_confirm", func(): pass)
  var on_cancel = props.get("on_cancel", func(): pass)
  var title = str(props.get("title", "⚠ 确认"))
  var warning_note = str(props.get("warning_note", ""))
  var note_rows = []
  if warning_note != "":
    note_rows.append(<Label text={ warning_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
  return (
    <PanelContainer style={ {"bg_color": GuStyle.PAPER_RAISED, "corner_radius_all": 8, "border_width_all": 2, "border_color": GuStyle.CINNABAR} }>
      <VBoxContainer>
        <PanelContainer style={ {"bg_color": Color(0.5, 0.12, 0.1, 0.85) } }>
          <MarginContainer style={ {"margin_left": 14, "margin_right": 14, "margin_top": 8, "margin_bottom": 8} }>
            <Label text={ title } style={ {"font_color": Color(1, 0.9, 0.85, 1), "font_size": 16} } />
          </MarginContainer>
        </PanelContainer>
        <MarginContainer style={ {"margin_left": 16, "margin_right": 16, "margin_top": 14, "margin_bottom": 14} }>
          <VBoxContainer style={ {"separation": 12} }>
            <Label text={ message } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 16} } />
            { note_rows }
            <HBoxContainer style={ {"separation": 12} }>
              <Button text={ cancel_label } onPressed={ func(): on_cancel.call() } style={ {"font_color": GuStyle.INK_SOFT, "min_width": 120, "min_height": 36} } />
              <Button text={ confirm_label } onPressed={ func(): on_confirm.call() } style={ {"font_color": GuStyle.CINNABAR, "min_width": 120, "min_height": 36} } />
            </HBoxContainer>
          </VBoxContainer>
        </MarginContainer>
      </VBoxContainer>
    </PanelContainer>
  )
}
