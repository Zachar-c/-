@theme "res://assets/theme/gu_theme.tres"
import { GuButton } from "~/ui/widgets/gu_button"
import { GuCard } from "~/ui/widgets/gu_card"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuConfirmDialog } from "~/ui/widgets/gu_confirm_dialog"

# RestScreen —— 休整 / 闭关屏（规格 v3 §7 C5 / R8 / R2.3）
# 强制二选一不可全拿；洗髓换骨一局一次、寿元+元石支付、真元上限实时刷新、死亡可预见预检。
# 突破节点出现成长奖励多选一（基础属性/蛊槽扩容/随机蛊/元石材料）。
# state 只读；choose / leave 经 commands。

export RestScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})
  var title = str(state.get("title", "闭关 · 休整"))
  var note = str(state.get("note", "强制二选一，不可全拿"))
  var is_ascension = bool(state.get("is_ascension", false))

  # 洗髓换骨（寿元代价）二次确认走 D1 弹窗族（R2.3 死亡可预见）；屏内 useState 驱动显隐。
  var st = useState({"wash_confirm": ""})
  var wash_confirm = str(st[0].get("wash_confirm", ""))
  var set_wash_confirm = st[1]

  var fire = func(key: String, arg = null):
    if commands.has(key):
      if arg != null:
        commands[key].call(arg)
      else:
        commands[key].call()

  # 休整选项
  var choices = state.get("choices", [])
  var choice_cards = []
  for c in choices:
    var cid = str(c.get("id", ""))
    var clabel = str(c.get("label", ""))
    var cdetail = str(c.get("detail", ""))
    var ccost = str(c.get("cost", ""))
    var cdisabled = bool(c.get("disabled", false))
    var creason = str(c.get("reason", ""))
    var cdanger = bool(c.get("curse_warning", false))
    var is_wash = (cid == "wash")
    var on_choose = func():
      if is_wash:
        set_wash_confirm.call({"wash_confirm": cid})
      else:
        fire.call("choose", cid)
    choice_cards.append((
      <GuCard title={ clabel } danger={ cdanger } expand_h={ true }>
        <Label text={ cdetail } style={ {"font_color": GuStyle.BONE, "font_size": 14} } />
        <Label text={ ccost } style={ {"font_color": GuStyle.GOLD, "font_size": 13} } />
        <Label text={ creason } style={ {"font_color": GuStyle.ANOMALY_AMBER, "font_size": 12} } />
        <GuButton label="选择" disabled={ cdisabled } danger={ is_wash } on_press={ on_choose } />
      </GuCard>
    ))
  var choice_empty = []
  if choice_cards.is_empty():
    choice_empty.append(<Label text="（当前无休整选项）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } />)

  var wash_choice = {}
  for c in choices:
    if str(c.get("id", "")) == wash_confirm:
      wash_choice = c
  var do_wash_cancel = func():
    set_wash_confirm.call({"wash_confirm": ""})
  var do_wash_confirm = func():
    set_wash_confirm.call({"wash_confirm": ""})
    fire.call("confirm_wash")

  # 成长奖励（仅突破）
  var growth = state.get("growth", [])
  var growth_rows = []
  for g in growth:
    var gid = str(g.get("id", ""))
    var glabel = str(g.get("label", ""))
    var gdetail = str(g.get("detail", ""))
    var gcost = str(g.get("cost", ""))
    growth_rows.append((
      <GuCard title={ glabel } expand_h={ true }>
        <Label text={ gdetail } style={ {"font_color": GuStyle.BONE, "font_size": 14} } />
        <Label text={ gcost } style={ {"font_color": GuStyle.GOLD, "font_size": 13} } />
        <GuButton label="选择" on_press={ func(): fire.call("choose", gid) } />
      </GuCard>
    ))

  var growth_section = []
  if is_ascension and growth.size() > 0:
    growth_section.append(<GuPanel title="突破成长 · 多选一" expand_v={ true }><HBoxContainer style={ {"separation": 10} }>{ growth_rows }</HBoxContainer></GuPanel>)

  return (
    <VBoxContainer style={ {"separation": 10} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } />
      <HBoxContainer style={ {"separation": 12} }>
        <Label text={ title } style={ {"font_color": GuStyle.GOLD, "font_size": 22} } />
        <Label text={ note } style={ {"font_color": GuStyle.ANOMALY_AMBER, "font_size": 14} } />
      </HBoxContainer>

      <GuPanel title="休整选项">
        <HBoxContainer style={ {"separation": 10} }>
          { choice_cards }
          { choice_empty }
        </HBoxContainer>
      </GuPanel>

      { growth_section }

      <GuButton label="离开" on_press={ func(): fire.call("leave") } />

      @if (wash_confirm != "") {
        return (
          <GuConfirmDialog
            title="洗髓换骨 · 寿元支付"
            message={ str(wash_choice.get("detail", "")) }
            warning_note={ "代价：" + str(wash_choice.get("cost", "")) + " · 一局一次 · 执行前预检寿元" }
            confirm_label="确认支付"
            on_confirm={ do_wash_confirm }
            on_cancel={ do_wash_cancel }
          />
        )
      }
    </VBoxContainer>
  )
}
