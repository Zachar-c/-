@theme "res://assets/theme/gu_theme.tres"
import { GuButton } from "~/ui/widgets/gu_button"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuTooltipView } from "~/ui/widgets/gu_tooltip_view"
import { GuConfirmDialog } from "~/ui/widgets/gu_confirm_dialog"
import { GuScrollBox } from "~/ui/widgets/gu_scroll_box"
import { GuDeathCauseOverlay } from "~/ui/widgets/gu_death_cause_overlay"
import { GuToast } from "~/ui/widgets/gu_toast"

# EncounterView —— 遭遇屏（修复「没按钮 / 危险选项无二次确认」）
# 契约：props.state 只读快照（含 node/actions/intel/resources/contracts/anomalies/death_lines）
#       props.commands 动作名 -> Callable（choose_option / confirm_danger / leave）
# 屏内零业务读写；仅在 on_press / on_confirm 回调中经 commands 触发。
# 严禁在组件体 / 渲染过程中发射任何命令。
# T5-B D2：危险死线行点击 → 死因查看浮层；纯 UI 态（useState 显隐），不过控制器。

export EncounterScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var st = useState({"confirming": ""})
  var confirming = st[0].get("confirming", "")
  var set_confirm = st[1]
  # 独立 hook：死因浮层显隐（setter 整体替换，勿与 confirming 合槽）。
  var cuist = useState({"cause_view": ""})
  var cause_view = str(cuist[0].get("cause_view", ""))
  var set_cause_view = cuist[1]

  var node = state.get("node", {})
  var actions = state.get("actions", [])
  var intel = state.get("intel", {})
  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})

  # 死因浮层取数：按 cause_id 回查本屏快照里的原始死线条目（只读）。
  var cause_line = {}
  for kind in death_lines.keys():
    var dl = death_lines[kind]
    if cause_view != "" and str(dl.get("cause_id", "")) == cause_view and bool(dl.get("danger", false)):
      cause_line = {
        "name": str(dl.get("name", kind)),
        "current": int(dl.get("remaining", 0)),
        "max": int(dl.get("max", 0)),
        "detail": str(dl.get("detail", "")),
      }
      break

  var fire = func(key: String, arg = null):
    if commands.has(key):
      if arg != null:
        commands[key].call(arg)
      else:
        commands[key].call()

  # ---- C4 侧边自身状态面板（§16.5）----
  var player = state.get("player", {})
  var php = int(player.get("hp", 0))
  var pmax = maxi(int(player.get("max_hp", 1)), 1)
  var pprim = int(player.get("primordial", 0))
  var psoul = int(player.get("soul", 0))
  var pstone = int(player.get("stone", 0))
  var gu_names = player.get("gu_names", [])
  var gu_rows = []
  for g in gu_names:
    gu_rows.append(<Label text={ "· " + str(g) } style={ {"font_color": GuStyle.BONE, "font_size": 13} } />)
  if gu_rows.is_empty():
    gu_rows.append(<Label text="（蛊囊空空）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 13} } />)

  var confirm_action = {}
  for a in actions:
    if str(a.get("id", "")) == confirming:
      confirm_action = a
  var confirm_msg = str(confirm_action.get("detail", ""))
  var confirm_note = "危险行动可能损耗寿元 / 魂魄 / 触发反噬，执行前请确认余量。"

  var do_confirm = func():
    fire.call("confirm_danger", confirming)
    set_confirm.call({"confirming": ""})
  var do_cancel = func():
    set_confirm.call({"confirming": ""})

  var has_leave = false
  var action_rows = []
  for a in actions:
    var aid = str(a.get("id", ""))
    var dangerous = bool(a.get("dangerous", false))
    var is_leave = (aid == "leave")
    if is_leave:
      has_leave = true
    var label = str(a.get("label", ""))
    var detail = str(a.get("detail", ""))
    var btn_label = "离开" if is_leave else ("确认此危险行动" if dangerous else "选择")

    var on_press_fn = func():
      if dangerous:
        set_confirm.call({"confirming": aid})
      else:
        if is_leave:
          fire.call("leave")
        else:
          fire.call("choose_option", aid)

    var tip = (
      <GuTooltipView
        title={ str(a.get("quality", "")) }
        quality={ str(a.get("quality", "")) }
        effect={ str(a.get("effect", "")) }
        synergy={ str(a.get("synergy", "")) }
        cost={ str(a.get("cost", "")) }
        curse_warning={ bool(a.get("curse_warning", false)) }
      />
    )

    var card = (
      <GuPanel title={ label }>
        <Label text={ detail } style={ {"font_color": GuStyle.DANGER if dangerous else GuStyle.BONE_DIM, "font_size": 14} } />
        @if (a.has("quality") or a.has("effect") or a.has("synergy") or a.has("cost") or bool(a.get("curse_warning", false))) {
          return tip
        }
        <GuButton label={ btn_label } danger={ dangerous } on_press={ on_press_fn } />
      </GuPanel>
    )
    action_rows.append(card)

  var feedback = str(state.get("feedback", ""))
  var feedback_row = []
  if feedback != "":
    feedback_row.append(<GuToast text={ feedback } tone="warn" />)

  return (
    <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } on_view={ func(cid): set_cause_view.call({"cause_view": str(cid)}) } />
      { feedback_row }

      <HBoxContainer name="primary_decision_surface" style={ {"separation": 14} }>
        <VBoxContainer style={ {"separation": 12, "size_flags_horizontal": 3} }>
          <GuPanel title={ "遭遇 · %s" % str(node.get("type", "")) }>
            <Label text={ str(node.get("title", "")) } style={ {"font_color": GuStyle.GOLD, "font_size": 18} } />
            <Label text={ str(node.get("desc", "")) } style={ {"font_color": GuStyle.BONE, "font_size": 14} } />
            @if (not intel.is_empty()) {
              return (
                <GuTooltipView
                  title="情报 / 弱点"
                  effect={ str(intel.get("weakness", "")) }
                  cost={ str(intel.get("cost", "")) }
                  curse_warning={ bool(intel.get("curse_warning", false)) }
                />
              )
            }
          </GuPanel>

          <GuScrollBox>
            @for (r in action_rows) {
              return r
            }
            @if (actions.is_empty()) {
              return (<Label text="（当前无可用行动）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } />)
            }
          </GuScrollBox>

          @if (not has_leave) {
            return (<GuButton label="离开" on_press={ func(): fire.call("leave") } />)
          }
        </VBoxContainer>

        <VBoxContainer style={ {"separation": 10, "min_width": 220} }>
          <GuPanel title="自身状态">
            <VBoxContainer style={ {"separation": 5} }>
              <Label text={ "气血 %d/%d" % [php, pmax] } style={ {"font_color": GuStyle.JADE, "font_size": 14} } />
              <Label text={ "魂魄 %d" % psoul } style={ {"font_color": GuStyle.JADE, "font_size": 14} } />
              <Label text={ "真元 %d" % pprim } style={ {"font_color": GuStyle.GOLD, "font_size": 14} } />
              <Label text={ "元石 %d" % pstone } style={ {"font_color": GuStyle.GOLD, "font_size": 14} } />
            </VBoxContainer>
          </GuPanel>
          <GuPanel title="蛊囊">
            <VBoxContainer style={ {"separation": 4} }>
              { gu_rows }
            </VBoxContainer>
          </GuPanel>
        </VBoxContainer>
      </HBoxContainer>

      @if (confirming != "") {
        return (
          <GuConfirmDialog title="⚠ 危险行动" message={ confirm_msg } warning_note={ confirm_note } on_confirm={ do_confirm } on_cancel={ do_cancel } />
        )
      }

      @if (not cause_line.is_empty()) {
        return (
          <GuDeathCauseOverlay line={ cause_line } on_close={ func(): set_cause_view.call({"cause_view": ""}) } />
        )
      }
    </VBoxContainer>
  )
}
