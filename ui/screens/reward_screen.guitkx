import { GuButton } from "~/ui/widgets/gu_button"
import { GuCard } from "~/ui/widgets/gu_card"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"

# RewardScreen —— 战利品确认屏（规格 v3 §7 C2 / R4 / §16.4）
# 2026-08-28 验收批：战利品已由 settle_victory 自动入账（§16.4 来源隔离由
# loot_tables 承担），本屏为确认展示而非再抽取——旧的拾取/替换/放弃按钮
# 发的是领域不存在的 reward_take/replace/skip 幽灵命令，全部移除。
# state 只读；close 经 commands。

export RewardScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})
  var title = str(state.get("title", "战利品"))
  var pool_fallback_note = str(state.get("pool_fallback_note", ""))
  var pity_note = str(state.get("pity_note", ""))

  var fire = func(key: String, arg = null):
    if commands.has(key):
      if arg != null:
        commands[key].call(arg)
      else:
        commands[key].call()

  var rewards = state.get("rewards", [])
  var reward_cards = []
  for r in rewards:
    var rname = str(r.get("name", ""))
    var rkind = str(r.get("kind", ""))
    var rqual = str(r.get("quality", ""))
    var reff = str(r.get("effect", ""))
    var rcost = str(r.get("cost", ""))
    var rcursed = (r.get("curse_warning", false))
    reward_cards.append((
      <GuCard title={ rname } quality={ rqual } danger={ rcursed } curse_warning={ rcursed } expand_h={ true }>
        <Label text={ rkind } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
        <Label text={ reff } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 14} } />
        <Label text={ rcost } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />
      </GuCard>
    ))
  var reward_empty = []
  if reward_cards.is_empty():
    reward_empty.append(<Label text="（本次无战利品）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)

  return (
    <MarginContainer style={ {"anchors_preset": "PRESET_FULL_RECT", "margin_left": GuStyle.SCREEN_MARGIN, "margin_right": GuStyle.SCREEN_MARGIN, "margin_top": 16, "margin_bottom": 24} }>
    <VBoxContainer style={ {"separation": 10, "anchors_preset": "PRESET_FULL_RECT"} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } />
      <HBoxContainer style={ {"separation": 12} }>
        <Label text={ title } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 22} } />
        <Label text="战利品已入账 · 本屏为确认展示" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
      </HBoxContainer>

      <VBoxContainer name="primary_decision_surface" style={ {"separation": 8} }>
        <Label text="本场所得" style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 18} } />
        <HBoxContainer style={ {"separation": 12} }>
          { reward_cards }
          { reward_empty }
        </HBoxContainer>
      </VBoxContainer>

      <VBoxContainer style={ {"separation": 4} }>
        @if (pool_fallback_note != "") {
          return ( <Label text={ pool_fallback_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } /> )
        }
        <Label text={ pity_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
      </VBoxContainer>

      <HBoxContainer style={ {"separation": 10} }>
        <GuButton label="继续旅程" on_press={ func(): fire.call("close") } />
      </HBoxContainer>
    </VBoxContainer>
    </MarginContainer>
  )
}
