import { GuButton } from "~/ui/widgets/gu_button"
import { GuCard } from "~/ui/widgets/gu_card"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuScrollBox } from "~/ui/widgets/gu_scroll_box"
import { GuConfirmDialog } from "~/ui/widgets/gu_confirm_dialog"
import { GuToast } from "~/ui/widgets/gu_toast"

# ShopScreen —— 黑市 / 商店屏（规格 v3 §7 C3 / §16.5 / §16.16）
# 商品板块（蛊/消耗品/材料/元石，价格） + 服务板块（领域真值计价/剩余次数）。
# 应急支付通道；NPC 立场徽章。
# 寿元代价交易（curse_warning）与元石不足触发的应急支付（R6.7）购买前走 D1 确认弹窗。
# 2026-08-28 验收批：移除「付费屏蔽此蛊」（池排除领域未实装，不留死按钮）；
# 服务面板接领域真值（candidates 目标选择流），use_service → service 真实命令。
# state 只读；buy / service / leave 经 commands。

export ShopScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})
  var title = str(state.get("title", "黑市"))
  var npc_name = str(state.get("npc_name", ""))
  var npc_stance = str(state.get("npc_stance", "中立"))
  var inflation_note = str(state.get("inflation_note", ""))
  var emergency_note = str(state.get("emergency_note", ""))
  var pool_fallback_note = str(state.get("pool_fallback_note", ""))

  # 危险交易（寿元代付等）二次确认；屏内 useState 驱动显隐。
  var st = useState({"confirm_offer": "", "service_id": ""})
  var confirm_offer = str(st[0].get("confirm_offer", ""))
  var set_confirm_offer = st[1]
  var active_service = str(st[0].get("service_id", ""))
  var set_service = st[1]

  var stance_color = GuStyle.JADE
  if npc_stance == "敌视":
    stance_color = GuStyle.ANOMALY_YELLOW
  elif npc_stance == "极度仇恨":
    stance_color = GuStyle.CINNABAR

  var fire = func(key: String, arg = null):
    if commands.has(key):
      if arg != null:
        commands[key].call(arg)
      else:
        commands[key].call()
  var fire2 = func(key: String, arg1, arg2):
    if commands.has(key):
      commands[key].call(arg1, arg2)

  # ---- 商品板块 ----
  var offers = state.get("offers", [])
  var offer_cards = []
  for o in offers:
    var oname = str(o.get("name", ""))
    var oprice = str(o.get("price", ""))
    var odesc = str(o.get("desc", ""))
    var oqual = str(o.get("quality", ""))
    var ocursed = bool(o.get("curse_warning", false))
    var oid = str(o.get("id", ""))
    var oemergency = bool(o.get("will_emergency_pay", false))
    var ask_buy = func():
      if ocursed or oemergency:
        set_confirm_offer.call({"confirm_offer": oid})
      else:
        fire.call("buy", oid)
    var btn_row = []
    btn_row.append(<GuButton label="购买此蛊" danger={ ocursed } on_press={ ask_buy } />)
    offer_cards.append((
      <GuCard title={ oname } quality={ oqual } danger={ ocursed } curse_warning={ ocursed } expand_h={ true }>
        <Label text={ odesc } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
        <Label text={ "价格：" + oprice } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 14} } />
        <HBoxContainer style={ {"separation": 6} }>
          { btn_row }
        </HBoxContainer>
      </GuCard>
    ))
  var offer_empty = []
  if offer_cards.is_empty():
    offer_empty.append(<Label text="（货架空空）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)

  # ---- 服务板块（领域真值：价格/剩余次数来自 service_price_for/service_limit）----
  var services = state.get("services", [])
  var service_rows = []
  for s in services:
    var sname = str(s.get("name", ""))
    var sprice = str(s.get("price", ""))
    var sremaining = int(s.get("remaining", 0))
    var snote = str(s.get("note", ""))
    var sid = str(s.get("id", ""))
    var sexec = bool(s.get("executable", true))
    var sblock = str(s.get("block_reason", ""))
    var starget_label = str(s.get("target_label", ""))
    var candidates = s.get("candidates", [])
    var use_service = func():
      if candidates.is_empty():
        fire.call("service", sid, "")
      else:
        set_service.call({"service_id": sid})
    var remain_text = "无次数上限" if sremaining < 0 else "本局剩 %d 次" % sremaining
    var service_block_rows = []
    if sblock != "":
      service_block_rows.append(<Label text={ "不可用 · " + sblock } style={ {"font_color": GuStyle.CINNABAR, "font_size": 12} } />)
    service_rows.append((
      <GuPanel expand_h={ true }>
        <HBoxContainer style={ {"separation": 8} }>
          <VBoxContainer style={ {"separation": 2, "size_flags_horizontal": 3} }>
            <Label text={ sname } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 15} } />
            <Label text={ "%s · %s" % [sprice, remain_text] } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />
            <Label text={ snote } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
            { service_block_rows }
          </VBoxContainer>
          <GuButton label="使用" disabled={ not sexec } on_press={ use_service } />
        </HBoxContainer>
      </GuPanel>
    ))
  var service_empty = []
  if service_rows.is_empty():
    service_empty.append(<Label text="（暂无服务）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)

  # 危险交易确认弹窗数据（按 confirm_offer 定位货架行）；应急支付与寿元代付文案分轨。
  var confirm_data = {}
  for o in offers:
    if str(o.get("id", "")) == confirm_offer:
      confirm_data = o
  var confirm_cursed = bool(confirm_data.get("curse_warning", false))
  var dialog_title = "⚠ 危险交易 · 寿元代付"
  var dialog_note = "价格：" + str(confirm_data.get("price", "")) + " · 以寿元支付，执行前请确认寿元余量"
  if not confirm_cursed and bool(confirm_data.get("will_emergency_pay", false)):
    dialog_title = "⚠ 应急支付"
    dialog_note = str(confirm_data.get("price", "")) + " · 元石不足，将以气血 / 寿元 / 反噬 / 销毁组件应急支付（R6.7）"
  var do_buy_cancel = func():
    set_confirm_offer.call({"confirm_offer": ""})
  var do_buy_confirm = func():
    set_confirm_offer.call({"confirm_offer": ""})
    fire.call("buy", confirm_offer)

  var feedback = str(state.get("feedback", ""))
  var feedback_row = []
  if feedback != "":
    feedback_row.append(<GuToast text={ feedback } tone="warn" />)

  # 服务目标选择面板数据（remove 类服务需指定目标；wash 直发无此面板）。
  var active_service_data = {}
  for s in services:
    if str(s.get("id", "")) == active_service:
      active_service_data = s
  var service_candidates = active_service_data.get("candidates", [])

  return (
    <VBoxContainer style={ {"separation": 10, "anchors_preset": "PRESET_FULL_RECT"} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } />
      { feedback_row }
      <HBoxContainer style={ {"separation": 12} }>
        <Label text={ title } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 22} } />
        <Label text={ inflation_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
        <Label text={ "NPC：" + npc_name } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 15} } />
        <Label text={ "立场·" + npc_stance } style={ {"font_color": stance_color, "font_size": 15} } />
      </HBoxContainer>

      <HBoxContainer name="primary_decision_surface" style={ {"separation": 14} }>
        <VBoxContainer style={ {"separation": 8, "size_flags_horizontal": 3} }>
          <Label text="蛊虫 / 货物" style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 18} } />
          <GuScrollBox height={ 420 }>
            <VBoxContainer style={ {"separation": 8} }>
              { offer_cards }
              { offer_empty }
            </VBoxContainer>
          </GuScrollBox>
          <Label text={ emergency_note } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />
          @if (pool_fallback_note != "") {
            return ( <Label text={ pool_fallback_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } /> )
          }
        </VBoxContainer>
        <VBoxContainer style={ {"separation": 8, "min_width": 360} }>
          <GuPanel title="服务">
            <GuScrollBox height={ 470 }>
              <VBoxContainer style={ {"separation": 8} }>
                { service_rows }
                { service_empty }
              </VBoxContainer>
            </GuScrollBox>
          </GuPanel>
          <GuButton label="离开黑市" on_press={ func(): fire.call("leave") } />
        </VBoxContainer>
      </HBoxContainer>

  @if (active_service != "" and active_service_data.get("executable", true)) {
    var target_rows = []
    for c in service_candidates:
      var cid = str(c.get("id", ""))
      var cname = str(c.get("name", ""))
      var cprice = str(c.get("price", ""))
      var pick = func():
        set_service.call({"service_id": ""})
        fire2.call("service", active_service, cid)
      var cand_label = cname if cprice == "" else "%s（%s）" % [cname, cprice]
      target_rows.append(<GuButton label={ "选定 " + cand_label } on_press={ pick } />)
    return (
      <GuPanel title={ str(active_service_data.get("target_label", "选择目标")) }>
        <GuScrollBox height={ 320 }>
          <VBoxContainer style={ {"separation": 6} }>
            { target_rows }
            <GuButton label="取消" on_press={ func(): set_service.call({"service_id": ""}) } />
          </VBoxContainer>
        </GuScrollBox>
      </GuPanel>
    )
  }

  @if (confirm_offer != "") {
    return (
      <GuConfirmDialog
        title={ dialog_title }
        message={ str(confirm_data.get("name", "")) + "：" + str(confirm_data.get("desc", "")) }
        warning_note={ dialog_note }
        confirm_label="确认支付"
        on_confirm={ do_buy_confirm }
        on_cancel={ do_buy_cancel }
      />
    )
  }
    </VBoxContainer>
  )
}
