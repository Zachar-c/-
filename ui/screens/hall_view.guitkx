import { GuButton } from "~/ui/widgets/gu_button"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuCard } from "~/ui/widgets/gu_card"
import { GuScrollBox } from "~/ui/widgets/gu_scroll_box"
import { GuToast } from "~/ui/widgets/gu_toast"

# HallView —— 大厅家族（规格 v3 §4.2/§5）：问眞主页 + A3 流派 + A4 契约占位
# + A5 图鉴 + A6 设置 + A7 手记，由 state.hall_subview 驱动（权威源）。
# 契约：state 只读快照；commands 动作名 -> Callable；屏内零业务读写。
# 实现注：为规避 guitkx @directive 解析限制，全部用 GDScript 构建 vnode 数组 + {array} 展开。

export HallView() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})
  var has_save = bool(state.get("has_save", false))
  var brand_title = str(state.get("brand_title", "問眞"))
  var primary_action = str(state.get("primary_action", "continue_run" if has_save else "open_schools"))
  var run_summary = state.get("run_summary", {})
  var subview = str(state.get("hall_subview", "main"))
  var selected_school = str(state.get("selected_school", ""))
  var selected_school_name = str(state.get("selected_school_name", selected_school))
  var schools = state.get("available_schools", [])
  var contracts = state.get("contracts", [])
  var meta = state.get("meta_stats", {})
  var codex = state.get("codex", {})
  var journal = state.get("journal", {"entries": []})
  var version_warning = str(state.get("hall_version_warning", ""))
  var dda_state_adaptive_enabled = bool(state.get("dda_state_adaptive_enabled", true))








  var fire = func(key: String):
    if commands.has(key):
      commands[key].call()

  # 带参动作派发（契约勾选等）：commands[key].call(arg)。
  var fire1 = func(key: String, arg):
    if commands.has(key):
      commands[key].call(arg)

  # 注：本组件不使用 useState hooks —— 直接 render() 调用（单测/冒烟）时 hooks 无法
  # 在脱离 RUI 框架的环境初始化，会返回 null。图鉴采用五类分节只读列表（§16.20 只读查阅）。

  # ── A5 图鉴（五类分节，纯只读）────────────────────────────
  if subview == "codex":
    var tab_names = {"gu": "蛊", "enemies": "敌人", "recipes": "配方", "inheritances": "传承", "relics": "遗物"}
    var tab_keys = ["gu", "enemies", "recipes", "inheritances", "relics"]
    var section_rows = []
    var total_entries = 0
    var total_unlocked = 0
    for k in tab_keys:
      var kk = k
      var sec_entries = codex.get(kk, [])
      var sec_cards = []
      for e in sec_entries:
        total_entries += 1
        var eunlocked = bool(e.get("unlocked", false))
        if eunlocked:
          total_unlocked += 1
        var ename = str(e.get("name", str(e.get("id", "?"))))
        var eschool = str(e.get("school", ""))
        var erarity = str(e.get("rarity", ""))
        var eid = str(e.get("id", ""))
        var school_line = ("流派：" + eschool) if eschool != "" else eid
        if eunlocked:
          sec_cards.append((
            <GuCard title={ ename } quality={ erarity }>
              <Label text={ school_line } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
            </GuCard>
          ))
        else:
          sec_cards.append((
            <GuCard title={ ename } sealed={ true }>
              <Label text="尚未遭遇 · 剪影" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
            </GuCard>
          ))
      var sec_title = str(tab_names.get(kk, kk))
      var sec_empty = []
      if sec_cards.is_empty():
        sec_empty.append(<Label text="（本类暂无条目）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
      section_rows.append((
        <GuPanel title={ sec_title }>
          <VBoxContainer style={ {"separation": 8} }>
            { sec_cards }
            { sec_empty }
          </VBoxContainer>
        </GuPanel>
      ))
    var completion = "%d/%d" % [total_unlocked, total_entries]
    return (
      <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
        <HBoxContainer style={ {"separation": 8} }>
          <Label text="百蛊录 · 图鉴" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 26} } />
          <Label text={ "完成度 " + completion } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
        </HBoxContainer>
        <GuScrollBox height={ 440 }>
          <VBoxContainer style={ {"separation": 10} }>
            { section_rows }
          </VBoxContainer>
        </GuScrollBox>
        <GuButton label="返回大厅" on_press={ func(): fire.call("back_to_hall") } />
      </VBoxContainer>
    )

  # ── A6 设置 ─────────────────────────────────────────────
  if subview == "settings":
    var version_rows = []
    if version_warning != "":
      version_rows.append(<GuToast text={ version_warning } tone="warn" />)
    return (
      <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
        { version_rows }
        <Label text="设置" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 26} } />
        <GuPanel title="显示与声音">
          <Label text="音量：待接入" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
          <Label text="分辨率：待接入" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
        </GuPanel>
        <GuPanel title="难度">
          <Label text="本局状态自适应难度（R14.6）" style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 14} } />
          <GuButton
            label={ "当前：" + ("开启" if dda_state_adaptive_enabled else "关闭") }
            on_press={ func(): fire.call("toggle_dda") }
          />
        </GuPanel>
        <GuPanel title="存档">
          <Label text="清除大厅存档需二次确认（规格 §16.22）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
        </GuPanel>
        <GuButton label="返回大厅" on_press={ func(): fire.call("back_to_hall") } />
        <GuButton label="退出游戏" on_press={ func(): fire.call("quit") } tone="danger" />
      </VBoxContainer>
    )

  # ── A7 手记库 ───────────────────────────────────────────
  if subview == "journal":
    var j_entries = journal.get("entries", [])
    var j_rows = []
    for je in j_entries:
      j_rows.append((
        <GuPanel title={ str(je.get("title", "")) }>
          <Label text={ str(je.get("body", "")) } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 14} } />
        </GuPanel>
      ))
    var journal_empty = []
    if j_rows.is_empty():
      journal_empty.append(<Label text="（尚无手记。轮回碎片将在结算后沉淀于此。）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
    return (
      <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
        <Label text="手记库" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 26} } />
        <GuScrollBox height={ 420 }>
          <VBoxContainer style={ {"separation": 8} }>
            { j_rows }
            { journal_empty }
          </VBoxContainer>
        </GuScrollBox>
        <GuButton label="返回大厅" on_press={ func(): fire.call("back_to_hall") } />
      </VBoxContainer>
    )

  # ── A3 流派选择 ─────────────────────────────────────────
  if subview == "schools":
    var school_cards = []
    for s in schools:
      var sid = ""
      var sname = str(s)
      var ssum = ""
      var sstarters = []
      if s is Dictionary:
        sid = str(s.get("id", ""))
        sname = str(s.get("name", sname))
        ssum = str(s.get("summary", ""))
        sstarters = s.get("starter_gu_names", [])
      var is_sel = (sid == selected_school)
      var sel_label = "选中 · " + sname if is_sel else "选择"
      var starter_line = "初始蛊：" + "、".join(sstarters) if sstarters.size() > 0 else ""
      var starter_rows = []
      if sstarters.size() > 0:
        starter_rows.append(<Label text={ starter_line } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 13} } />)
      school_cards.append((
        <GuCard title={ sname } highlight={ is_sel }>
          <Label text={ ssum } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
          { starter_rows }
          <Button text={ sel_label } onPressed={ func(): fire.call("select_school", sid) } style={ {"font_color": GuStyle.JADE if is_sel else GuStyle.JADE, "font_size": 14} } />
        </GuCard>
      ))
    var selected_label = "当前选中：" + selected_school_name
    return (
      <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
        <Label text="流派选择" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 26} } />
        <Label text={ selected_label } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 14} } />
        <GuScrollBox height={ 400 }>
          <VBoxContainer style={ {"separation": 10} }>
            { school_cards }
          </VBoxContainer>
        </GuScrollBox>
        <HBoxContainer style={ {"separation": 12} }>
          <GuButton label="确认流派 → 契约" on_press={ func(): fire.call("open_contracts") } />
          <GuButton label="返回" on_press={ func(): fire.call("back_to_hall") } />
        </HBoxContainer>
      </VBoxContainer>
    )

  # ── A4 契约选择（§15/§16.13 实装）────────────────────────
  # contracts 来自快照结构化列表（id/name/desc/locked/selected）；
  # 勾选经 toggle_contract 进入开局立誓（swear 门禁在领域侧，九类拒绝）。
  if subview == "contracts":
    var contract_cards = []
    for c in contracts:
      var cid = str(c.get("id", ""))
      var cname = str(c.get("name", cid))
      var cdesc = str(c.get("desc", ""))
      var clocked = bool(c.get("locked", false))
      var csel = bool(c.get("selected", false))
      var toggle_label = "已勾选 · 点击取消" if csel else ("未解锁" if clocked else "勾选")
      contract_cards.append((
        <GuCard title={ cname } highlight={ csel }>
          <Label text={ cdesc } style={ {"font_color": GuStyle.CONTRACT_BLUE, "font_size": 13} } />
          <Button text={ toggle_label } disabled={ clocked } onPressed={ func(): fire1.call("toggle_contract", cid) } style={ {"font_color": GuStyle.INK_SOFT if clocked else (GuStyle.ANOMALY_YELLOW if csel else GuStyle.JADE), "font_size": 14} } />
        </GuCard>
      ))
    var contract_note = "勾选将于开局立誓生效；同时启用软上限 5–6 条，普通手段不可撤销。" if contract_cards.size() > 0 else "当前无可用契约数据，直接以所选流派开始冒险。"
    return (
      <VBoxContainer style={ {"separation": 12, "anchors_preset": "PRESET_FULL_RECT"} }>
        <Label text="难度契约" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 26} } />
        <Label text={ contract_note } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
        <GuScrollBox height={ 400 }>
          <VBoxContainer style={ {"separation": 10} }>
            { contract_cards }
          </VBoxContainer>
        </GuScrollBox>
        <HBoxContainer style={ {"separation": 12} }>
          <GuButton label="开始冒险" on_press={ func(): fire.call("new_run") } size="large" />
          <GuButton label="返回流派" on_press={ func(): fire.call("open_schools") } />
        </HBoxContainer>
      </VBoxContainer>
    )

  # ── A2 主界面（默认根，“这一世的第一页”）──────────────────
  var primary_label = "续入此世" if primary_action == "continue_run" else "开始此世"
  var summary_rows = []
  if has_save:
    summary_rows.append(<Label name="hall_summary_route" text={ "行路\n" + str(run_summary.get("route", "未载入行路")) } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 15} } />)
    summary_rows.append(<Label name="hall_summary_rank" text={ "修为\n" + str(run_summary.get("rank", 0)) + " 转" } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 15} } />)
    summary_rows.append(<Label name="hall_summary_hp" text={ "气血\n" + str(run_summary.get("hp", 0)) } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 15} } />)

  var meta_rows = []
  for contract in state.get("contracts", []):
    var contract_label = str(contract.get("name", contract.get("id", "契约"))) if contract is Dictionary else str(contract)
    meta_rows.append(<Label text={ "契约 · " + contract_label } style={ {"font_color": GuStyle.CONTRACT_BLUE, "font_size": 12, "border_width_left": 2, "border_color": GuStyle.CONTRACT_BLUE, "content_margin_left": 8} } />)
  for anomaly in state.get("anomalies", []):
    var anomaly_label = str(anomaly.get("label", anomaly.get("id", "异变"))) if anomaly is Dictionary else str(anomaly)
    meta_rows.append(<Label text={ "异变 · " + anomaly_label } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 12, "border_width_left": 2, "border_color": GuStyle.ANOMALY_YELLOW, "content_margin_left": 8} } />)

  var no_save_rows = []
  if not has_save:
    no_save_rows.append(<Label text="新一世不会继承修为、蛊虫或元石。已解锁的蛊方、手记与契约仍可查阅。" autowrap_mode={ TextServer.AUTOWRAP_WORD_SMART } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13, "custom_minimum_size": Vector2(0, 54)} } />)

  return (
    <Control style={ {"anchors_preset": "PRESET_FULL_RECT"} }>
      <ColorRect name="hall_paper" color={ GuStyle.PAPER_RAISED } mouse_filter={ Control.MOUSE_FILTER_IGNORE } style={ {"anchors_preset": "PRESET_FULL_RECT"} } />
      <Label name="hall_folio" text="逐道 · 南疆" position={ Vector2(29, 25) } style={ {"font_color": GuStyle.INK_MUTED, "font_size": 10} } />
      <PanelContainer name="hall_seal" anchor_left={ 1.0 } anchor_right={ 1.0 } offset_left={ -75.0 } offset_right={ -30.0 } offset_top={ 27.0 } offset_bottom={ 72.0 } style={ {"bg_color": Color(0, 0, 0, 0), "border_width_all": 1, "border_color": GuStyle.CINNABAR} }>
        <CenterContainer><Label text="真性\n自持" horizontal_alignment={ HORIZONTAL_ALIGNMENT_CENTER } style={ {"font_color": GuStyle.CINNABAR, "font_size": 12} } /></CenterContainer>
      </PanelContainer>
      <Control name="hall_sheet" anchor_left={ 0.07 } anchor_right={ 0.93 } anchor_bottom={ 1.0 } offset_top={ 72.0 } offset_bottom={ -48.0 }>
        <VBoxContainer name="hall_identity" anchor_right={ 0.38 } anchor_bottom={ 1.0 } style={ {"separation": GuStyle.SPACE_4} }>
          <Control style={ {"size_flags_vertical": "SIZE_EXPAND_FILL"} } />
          <Label text="蠱為術，道為途，我自問眞" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
          <Label name="hall_title" text={ brand_title } style={ {"font": GuStyle.TITLE_FONT, "font_color": GuStyle.INK_PRIMARY, "font_size": 96} } />
          <ColorRect color={ GuStyle.CINNABAR } custom_minimum_size={ Vector2(58, 3) } />
          <Label text="上一世止於：青茅山 · 三轉\n此世命題：命蠱相爭，眞性自持" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />
          <Control style={ {"size_flags_vertical": "SIZE_EXPAND_FILL"} } />
        </VBoxContainer>

        <ColorRect name="hall_primary_rule" color={ GuStyle.HAIRLINE_COLOR } anchor_left={ 0.44 } anchor_right={ 0.44 } anchor_bottom={ 1.0 } offset_right={ 1.0 } />
        <VBoxContainer name="hall_primary" anchor_left={ 0.44 } anchor_right={ 0.80 } anchor_bottom={ 1.0 } offset_left={ 50.0 } style={ {"separation": GuStyle.SPACE_4} }>
            <Control style={ {"size_flags_vertical": "SIZE_EXPAND_FILL"} } />
            <Label text={ "命蠱 · 第 %s 卷" % ("六十三" if has_save else "新") } style={ {"font_color": GuStyle.INK_MUTED, "font_size": 13} } />
            <Button name="hall_primary_action" role="primary" text={ primary_label + " ›" } onPressed={ func(): fire.call(primary_action) } style={ {"font": GuStyle.TITLE_FONT, "font_color": GuStyle.INK_PRIMARY, "font_size": 30, "min_height": 64, "bg_color": Color(0, 0, 0, 0), "border_width_left": 3, "border_color": GuStyle.CINNABAR, "content_margin_left": GuStyle.SPACE_3, "focus": {"border_width_all": 1, "border_color": GuStyle.CINNABAR} } } />
            <Label text={ "将从 " + str(run_summary.get("route", "流派选择")) + (" 继续。此世没有回溯。" if has_save else " 开始，随后进入南疆。") } autowrap_mode={ TextServer.AUTOWRAP_WORD_SMART } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13} } />
            { no_save_rows }
            <HBoxContainer style={ {"separation": GuStyle.SPACE_5} }>{ summary_rows }</HBoxContainer>
            <HBoxContainer style={ {"separation": GuStyle.SPACE_3} }>{ meta_rows }</HBoxContainer>
            <Control style={ {"size_flags_vertical": "SIZE_EXPAND_FILL"} } />
        </VBoxContainer>

        <ColorRect name="hall_archive_rule" color={ GuStyle.HAIRLINE_COLOR } anchor_left={ 0.85 } anchor_right={ 0.85 } anchor_bottom={ 1.0 } offset_right={ 1.0 } />
        <VBoxContainer name="hall_archive" anchor_left={ 0.85 } anchor_right={ 1.0 } anchor_top={ 1.0 } anchor_bottom={ 1.0 } offset_left={ 26.0 } offset_top={ -180.0 } style={ {"separation": GuStyle.SPACE_2} }>
          <Button text="手记库" onPressed={ func(): fire.call("open_journal") } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13, "bg_color": Color(0, 0, 0, 0), "border_width_bottom": 1, "border_color": GuStyle.HAIRLINE_COLOR} } />
          <Button text="图鉴" onPressed={ func(): fire.call("open_codex") } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13, "bg_color": Color(0, 0, 0, 0), "border_width_bottom": 1, "border_color": GuStyle.HAIRLINE_COLOR} } />
          <Button text="设置" onPressed={ func(): fire.call("open_settings") } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 13, "bg_color": Color(0, 0, 0, 0), "border_width_bottom": 1, "border_color": GuStyle.HAIRLINE_COLOR} } />
        </VBoxContainer>
      </Control>
    </Control>
  )
}
