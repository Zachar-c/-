import { GuButton } from "~/ui/widgets/gu_button"
import { GuToast } from "~/ui/widgets/gu_toast"

# DebugPanel —— D5 开发者调试面板（§16.22 硬红线）
# 仅开发构建由 RunController 门控挂载（Release 下零节点存在，本组件不会被创建）；
# 视觉与正式 UI 明显区分：灰底（BG_DEEP 90%）+ 红字「调试」角标；折叠态只剩把手条。
# 只读情报来自快照 debug 段（保底计数 / 池排除列表 / 种子 / 事件数 / DDA 分位）；
# 写操作全部经 commands 走控制器正式校验通道，本组件不持任何领域状态。

export DebugPanel() -> RuitkVNode {
  var open_flag = bool(props.get("open", false))
  var feedback = str(props.get("feedback", ""))
  var info = props.get("info", {})
  var gu_input = str(props.get("gu_input", ""))
  var res_kind = str(props.get("res_kind", "yuanstone"))
  var res_value = str(props.get("res_value", ""))
  var travel_options = props.get("travel_options", [])
  var travel_selected = str(props.get("travel_selected", ""))
  var commands = props.get("commands", {})

  var kind_items = ["yuanstone", "health", "lifespan", "soul", "essence"]
  var kind_labels = ["元石", "生命", "寿元", "魂魄", "真元"]
  var kind_index = kind_items.find(res_kind)
  if kind_index < 0:
    kind_index = 0

  var fire0 = func(key: String):
    if commands.has(key):
      commands[key].call()
  var fire1 = func(key: String, arg):
    if commands.has(key):
      commands[key].call(arg)

  var toggle_label = "收起 ▲" if open_flag else "展开 ▼"

  var body_rows = []
  if open_flag:
    # —— 加蛊（走控制器正式容量校验）——
    body_rows.append(<Label text="加蛊" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />)
    body_rows.append(
      <HBoxContainer style={ {"separation": 6} }>
        <LineEdit text={ gu_input } placeholder_text="gu_id 例: small_light_gu" custom_minimum_size={ Vector2(180, 0) } onTextChanged={ func(v): fire1.call("set_gu_input", v) } />
        <GuButton label="加蛊" on_press={ func(): fire0.call("add_gu") } />
      </HBoxContainer>
    )
    # —— 资源设置（控制器侧钳制到合法区间）——
    body_rows.append(<Label text="资源设置" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />)
    body_rows.append(
      <HBoxContainer style={ {"separation": 6} }>
        <OptionButton items={ kind_labels } selected={ kind_index } onItemSelected={ func(idx): fire1.call("set_res_kind", kind_items[int(idx)]) } />
        <LineEdit text={ res_value } placeholder_text="整数" custom_minimum_size={ Vector2(80, 0) } onTextChanged={ func(v): fire1.call("set_res_value", v) } />
        <GuButton label="应用" on_press={ func(): fire0.call("apply_resource") } />
      </HBoxContainer>
    )
    # —— 跳层（仅当前可见节点，防越层破坏地图不变量）——
    body_rows.append(<Label text="跳层 · 仅可见节点" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />)
    if travel_options.size() > 0:
      var opt_labels = []
      var selected_index = 0
      for opt_i in travel_options.size():
        var opt = travel_options[opt_i]
        opt_labels.append(str(opt.get("label", str(opt.get("id", "")))))
        if str(opt.get("id", "")) == travel_selected:
          selected_index = opt_i
      body_rows.append(
        <HBoxContainer style={ {"separation": 6} }>
          <OptionButton items={ opt_labels } selected={ selected_index } onItemSelected={ func(idx): fire1.call("set_travel_node", str(travel_options[int(idx)].get("id", ""))) } />
          <GuButton label="跳" on_press={ func(): fire0.call("travel") } />
        </HBoxContainer>
      )
    else:
      body_rows.append(<Label text="（无可跳节点）" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />)
    # —— 池情报（只读，形状对齐 query_loot_state）——
    body_rows.append(<Label text="池情报 · 只读" style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />)
    var pity = info.get("pity", {})
    body_rows.append(
      <Label text={ "保底计数 · 蛊 %d / 材料 %d" % [int(pity.get("loot_pity", 0)), int(pity.get("material_pity", 0))] } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
    )
    body_rows.append(
      <Label text={ "合成连败 %d" % int(pity.get("synthesis_fail_streak", 0)) } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
    )
    var excluded_items = info.get("excluded", [])
    var excluded_text = "（无）"
    if excluded_items.size() > 0:
      var parts = []
      for ex in excluded_items:
        parts.append(str(ex))
      excluded_text = ", ".join(parts)
    body_rows.append(
      <Label text={ "池排除列表：" + excluded_text } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
    )
    body_rows.append(
      <Label text={ "当前种子 %d · 事件数 %d" % [int(info.get("seed", 0)), int(info.get("event_count", 0))] } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 12} } />
    )
    if str(info.get("dda_percentile", "")) != "":
      body_rows.append(
        <Label text={ "DDA 分位：" + str(info.get("dda_percentile", "")) } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 12} } />
      )
    # —— 快照打印 ——
    body_rows.append(<GuButton label="打印 RunData 快照" on_press={ func(): fire0.call("snapshot_dump") } />)

  var feedback_row = []
  if feedback != "":
    feedback_row.append(<GuToast text={ feedback } tone="warn" />)

  return (
    <PanelContainer style={ {"anchors_preset": "PRESET_BOTTOM_RIGHT", "bg_color": Color(GuStyle.PAPER_BG, 0.9), "corner_radius_all": 6, "border_width_all": 1, "border_color": GuStyle.CINNABAR} }>
      <MarginContainer style={ {"margin_left": 10, "margin_right": 10, "margin_top": 8, "margin_bottom": 8} }>
        <VBoxContainer style={ {"separation": 6} }>
          <HBoxContainer style={ {"separation": 10} }>
            <Label text="调试" style={ {"font_color": GuStyle.CINNABAR, "font_size": 15} } />
            <Label text="DEV ONLY · F12" style={ {"font_color": GuStyle.INK_SOFT, "font_size": 11} } />
            <GuButton label={ toggle_label } on_press={ func(): fire0.call("toggle_open") } />
          </HBoxContainer>
          { body_rows }
          { feedback_row }
        </VBoxContainer>
      </MarginContainer>
    </PanelContainer>
  )
}
