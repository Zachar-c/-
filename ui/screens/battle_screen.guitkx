@theme "res://assets/theme/gu_theme.tres"
import { GuButton } from "~/ui/widgets/gu_button"
import { GuCard } from "~/ui/widgets/gu_card"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuTooltipView } from "~/ui/widgets/gu_tooltip_view"
import { GuStatBar } from "~/ui/widgets/gu_stat_bar"
import { GuScrollBox } from "~/ui/widgets/gu_scroll_box"

# BattleScreen —— 战斗屏三区语法（规格 v3 §7 C1）
# 顶 HUD（顶栏+死线）→ 中战场（左我右敌、意图符文⚔🛡☾+数值+效果）→ 底操作（真元+手牌卡带+回合控制）。
# state 只读；play_card/end_turn/ultimate/refine/flee 经 commands。
# 意图攻击=红、防御=金；生命护盾分条（§16.5）；卡牌 tooltip 固定格式。

export BattleScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})

  var fire = func(key: String, arg = null):
    if commands.has(key):
      if arg != null:
        commands[key].call(arg)
      else:
        commands[key].call()

  # ---- 敌方战场区（意图符文 + 数值 + 效果）----
  var enemies = state.get("enemies", [])
  var enemy_cards = []
  for e in enemies:
    var ename = str(e.get("name", ""))
    var ehp = int(e.get("hp", 0))
    var emax = maxi(int(e.get("max_hp", 1)), 1)
    var eshield = int(e.get("shield", 0))
    var intent = e.get("intent", {})
    var itype = str(intent.get("type", ""))
    var ival = int(intent.get("value", 0))
    var idetail = str(intent.get("detail", ""))
    var rune = "意图：施咒"
    var itext = "蓄势待发"
    var intent_color = GuStyle.BONE_DIM
    if itype == "attack":
      rune = "意图：⚔ 攻击"
      itext = "%d · %s" % [ival, idetail]
      intent_color = GuStyle.DANGER
    elif itype == "defend" or itype == "guard":
      rune = "意图：🛡 防御"
      itext = "%d · %s" % [ival, idetail]
      intent_color = GuStyle.GOLD
    elif itype == "charge":
      rune = "意图：☾ 蓄力"
      itext = "蓄势待发"
      intent_color = GuStyle.SILVER
    enemy_cards.append((
      <GuCard title={ ename }>
        <GuStatBar label="气力" value={ ehp } max_value={ emax } color={ GuStyle.DANGER } shield={ eshield } />
        <Label text={ rune } style={ {"font_color": intent_color, "font_size": 18} } />
        <Label text={ itext } style={ {"font_color": intent_color, "font_size": 13} } />
      </GuCard>
    ))
  var enemy_empty = []
  if enemy_cards.is_empty():
    enemy_empty.append(<Label text="（无敌人）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } />)

  # ---- 我方战场区 ----
  var player = state.get("player", {})
  var php = int(player.get("hp", 0))
  var pmax = maxi(int(player.get("max_hp", 1)), 1)
  var pshield = int(player.get("shield", 0))
  var pprim = int(player.get("primordial", 0))
  var psoul = int(player.get("soul", 0))
  var statuses = player.get("statuses", [])
  var status_labels = []
  for s in statuses:
    var sname = str(s.get("name", ""))
    var sstacks = int(s.get("stacks", 0))
    status_labels.append(
      <Label text={ "%s %d 层" % [sname, sstacks] } style={ {"font_color": GuStyle.DANGER, "font_size": 14} } />
    )

  # ---- 手牌卡带 ----
  var hand = state.get("hand", [])
  var hand_rows = []
  for c in hand:
    var cid = str(c.get("id", ""))
    var cname = str(c.get("name", ""))
    var ccost = int(c.get("cost", 0))
    var ceff = str(c.get("effect", ""))
    var cqual = str(c.get("quality", ""))
    var ccurse = bool(c.get("curse_warning", false))
    var cost_ex = str(c.get("cost_ex", ""))
    var cost_str = cost_ex if cost_ex != "" else ("消耗 %d" % ccost)
    var on_play = func():
      var tgt = str(state.get("default_target_id", ""))
      if tgt == "" and enemies.size() > 0:
        tgt = str(enemies[0].get("id", ""))
      if commands.has("play_card"):
        commands["play_card"].call(cid, tgt)
    var tip = (
      <GuTooltipView
        title={ cname }
        quality={ cqual }
        effect={ ceff }
        cost={ cost_str }
        curse_warning={ ccurse }
      />
    )
    hand_rows.append((
      <GuCard title={ cname } danger={ ccurse }>
        <Label text={ cost_str } style={ {"font_color": GuStyle.GOLD, "font_size": 13} } />
        <Label text={ "效果：" + ceff } style={ {"font_color": GuStyle.BONE_DIM, "font_size": 13} } />
        { tip }
        <GuButton label="出牌" danger={ ccurse } on_press={ on_play } />
      </GuCard>
    ))
  var hand_empty = []
  if hand_rows.is_empty():
    hand_empty.append(<Label text="（无手牌）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } />)

  # ---- 底操作区 ----
  var ops = []
  ops.append(<GuButton label="结束回合" on_press={ func(): fire.call("end_turn") } />)
  if bool(state.get("can_ultimate", false)):
    ops.append(<GuButton label="杀招" danger={ true } on_press={ func(): fire.call("ultimate") } />)
  if commands.has("refine"):
    ops.append(<GuButton label="炼蛊" on_press={ func(): fire.call("refine") } />)
  if commands.has("flee"):
    ops.append(<GuButton label="撤退" on_press={ func(): fire.call("flee") } />)

  return (
    <VBoxContainer style={ {"separation": 10} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } on_view={ func(cid): fire.call("view_death_cause", cid) } />

      <HBoxContainer style={ {"separation": 14} }>
        <GuPanel title="我方">
          <VBoxContainer style={ {"separation": 6} }>
            <GuStatBar label="生命" value={ php } max_value={ pmax } color={ GuStyle.JADE } shield={ pshield } />
            <GuStatBar label="真元" value={ pprim } max_value={ maxi(pprim, 1) } color={ GuStyle.GOLD } />
            <GuStatBar label="魂魄" value={ psoul } max_value={ maxi(psoul, 1) } color={ GuStyle.JADE } />
            { status_labels }
          </VBoxContainer>
        </GuPanel>

        <GuPanel title="敌方">
          <HBoxContainer style={ {"separation": 12} }>
            { enemy_cards }
            { enemy_empty }
          </HBoxContainer>
        </GuPanel>
      </HBoxContainer>

      <GuPanel title="手牌">
        <GuScrollBox height={ 260 }>
          <HBoxContainer style={ {"separation": 10} }>
            { hand_rows }
            { hand_empty }
          </HBoxContainer>
        </GuScrollBox>
      </GuPanel>

      <HBoxContainer style={ {"separation": 12} }>
        <Label text={ "真元 " + str(pprim) } style={ {"font_color": GuStyle.GOLD, "font_size": 18} } />
        { ops }
      </HBoxContainer>
    </VBoxContainer>
  )
}
