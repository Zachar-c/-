import { GuBattleHand } from "~/ui/widgets/gu_battle_hand"
import { GuButton } from "~/ui/widgets/gu_button"
import { GuConfirmDialog } from "~/ui/widgets/gu_confirm_dialog"
import { GuDeathCauseOverlay } from "~/ui/widgets/gu_death_cause_overlay"
import { GuEnemyActor } from "~/ui/widgets/gu_enemy_actor"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuStatBar } from "~/ui/widgets/gu_stat_bar"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuToast } from "~/ui/widgets/gu_toast"
import { GuTooltipView } from "~/ui/widgets/gu_tooltip_view"

# Battle state is snapshot-only. interaction is local presentation state and is
# intentionally the sole place that decides when a card command may be submitted.
export BattleScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})
  var ui_state = useState({"mode": "idle", "card": {}, "card_id": "", "target_id": "", "confirming": false, "cause_view": "", "expanded_enemies": false})
  var interaction = ui_state[0]
  var set_interaction = ui_state[1]
  var mode = str(interaction.get("mode", "idle"))
  var active_card = interaction.get("card", {})
  var cause_view = str(interaction.get("cause_view", ""))
  var valid_targets = active_card.get("valid_target_ids", [])
  var enemies = state.get("enemies", [])
  var visible_enemies = enemies.slice(0, mini(3, enemies.size()))
  var remainder = enemies.slice(3)
  if bool(interaction.get("expanded_enemies", false)):
    visible_enemies = enemies
    remainder = []

  var reset_interaction = func(): set_interaction.call({"mode": "idle", "card": {}, "card_id": "", "target_id": "", "confirming": false, "cause_view": "", "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
  var set_mode = func(next_mode, card = active_card): set_interaction.call({"mode": next_mode, "card": card, "card_id": str(card.get("id", "")), "target_id": "", "confirming": false, "cause_view": cause_view, "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
  var submit_card = func(card, target_id):
    if commands.has("play_card"):
      commands["play_card"].call(str(card.get("id", "")), target_id)
    set_interaction.call({"mode": "play_success", "card": card, "card_id": str(card.get("id", "")), "target_id": target_id, "confirming": false, "cause_view": "", "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
  var play_card = func(card):
    if str(card.get("target_type", "none")) == "single_enemy":
      set_interaction.call({"mode": "target_select", "card": card, "card_id": str(card.get("id", "")), "target_id": "", "confirming": false, "cause_view": cause_view, "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
    elif bool(card.get("known_risk", false)) or bool(card.get("dangerous", false)):
      set_interaction.call({"mode": "dragging", "card": card, "card_id": str(card.get("id", "")), "target_id": "", "confirming": true, "cause_view": "", "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
    else:
      submit_card.call(card, "")
  var select_enemy = func(enemy_id):
    if mode != "target_select" or not valid_targets.has(enemy_id):
      return
    if bool(active_card.get("known_risk", false)) or bool(active_card.get("dangerous", false)):
      set_interaction.call({"mode": "target_select", "card": active_card, "card_id": str(active_card.get("id", "")), "target_id": enemy_id, "confirming": true, "cause_view": "", "expanded_enemies": bool(interaction.get("expanded_enemies", false))})
    else:
      submit_card.call(active_card, enemy_id)

  var enemy_rows = []
  for enemy in visible_enemies:
    var enemy_id = str(enemy.get("id", ""))
    enemy_rows.append(<GuEnemyActor enemy={ enemy } selected={ str(interaction.get("target_id", "")) == enemy_id } selectable={ mode == "target_select" and valid_targets.has(enemy_id) } on_select={ select_enemy } />)
  if not remainder.is_empty():
    enemy_rows.append(<Button name="enemy_remainder" text={ "余敌 %d" % remainder.size() } onPressed={ func(): set_interaction.call({"mode": mode, "card": active_card, "card_id": str(active_card.get("id", "")), "target_id": str(interaction.get("target_id", "")), "confirming": bool(interaction.get("confirming", false)), "cause_view": cause_view, "expanded_enemies": true}) } style={ {"font_color": GuStyle.INK_PRIMARY, "min_height": 32} } />)

  var player = state.get("player", {})
  var piles = state.get("piles", {})
  var soul_ops = state.get("soul_ops", {})
  var cause_line = {}
  for kind in state.get("death_lines", {}).keys():
    var line = state["death_lines"][kind]
    if str(line.get("cause_id", "")) == cause_view and bool(line.get("danger", false)):
      cause_line = {"name": str(line.get("name", kind)), "current": int(line.get("remaining", 0)), "max": int(line.get("max", 0)), "detail": str(line.get("detail", ""))}

  var ops = []
  ops.append(<GuButton label="结束回合" on_press={ func(): if commands.has("end_turn"): commands["end_turn"].call() } />)
  if commands.has("ultimate"):
    ops.append(<GuButton label="杀招" on_press={ func(): commands["ultimate"].call() } />)
  if commands.has("refine"):
    ops.append(<GuButton label="炼蛊" on_press={ func(): commands["refine"].call() } />)
  if commands.has("flee") and bool(state.get("flee_available", true)):
    ops.append(<GuButton label="撤退" on_press={ func(): commands["flee"].call() } />)
  var kill_rows = []
  for kill_move in state.get("kill_moves", []):
    kill_rows.append(<Label text={ "杀招 · %s · %s" % [str(kill_move.get("name", "")), str(kill_move.get("sequence_display", ""))] } style={ {"font_color": GuStyle.INK_MUTED, "font_size": 13} } />)
  var hint_rows = []
  var boss_hint = DisplayText.dda_hint(str(state.get("dda_boss_hint", "")))
  if boss_hint != "":
    hint_rows.append(<Label text={ boss_hint } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 13} } />)
  var feedback_rows = []
  if str(state.get("feedback", "")) != "":
    feedback_rows.append(<GuToast text={ str(state.get("feedback", "")) } tone="warn" />)
  var confirm_row = []
  if bool(interaction.get("confirming", false)):
    confirm_row.append(<GuConfirmDialog title="⚠ 危险行动" message={ str(active_card.get("name", "此行动")) + " 将执行已预览的不可逆代价。" } warning_note={ str(active_card.get("known_risk", "")) } on_confirm={ func(): submit_card.call(active_card, str(interaction.get("target_id", ""))) } on_cancel={ func(): set_mode.call("drag_cancel", active_card) } />)
  var hand_tooltip_rows = []
  if mode == "hover" or mode == "target_select":
    var hovered_card = active_card
    if not hovered_card.is_empty():
      var hovered_name = str(hovered_card.get("name", "蛊虫"))
      var hovered_quality = str(hovered_card.get("quality", ""))
      var hovered_effect = str(hovered_card.get("effect", ""))
      var hovered_cost = str(hovered_card.get("cost_ex", str(hovered_card.get("cost", ""))))
      var hovered_block = str(hovered_card.get("block_reason", ""))
      var hovered_curse = bool(hovered_card.get("curse_warning", false))
      var hovered_executable = bool(hovered_card.get("executable", true))
      var synergy = str(hovered_card.get("synergy", ""))
      var segments = []
      segments.append(<Label name="hand_tooltip_title" text={ hovered_name } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 16} } />)
      if hovered_quality != "":
        segments.append(<Label text={ "品质：" + hovered_quality } style={ {"font_color": GuStyle.quality_color(hovered_quality), "font_size": 12} } />)
      if hovered_effect != "":
        segments.append(<Label text={ "效果：" + hovered_effect } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
      if synergy != "":
        segments.append(<Label text={ "联动：" + synergy } style={ {"font_color": GuStyle.INK_SOFT, "font_size": 14} } />)
      if hovered_cost != "":
        segments.append(<Label text={ "代价：" + hovered_cost } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 14} } />)
      if not hovered_executable and hovered_block != "":
        segments.append(<Label text={ "不可用：" + hovered_block } style={ {"font_color": GuStyle.CINNABAR, "font_size": 14} } />)
      if hovered_curse:
        segments.append(<Label text="诅咒警示：执行即受反噬。" style={ {"font_color": GuStyle.CINNABAR, "font_size": 14} } />)
      hand_tooltip_rows.append(<PanelContainer name="battle_hand_tooltip_host" style={ {"bg_color": GuStyle.PAPER_RAISED, "corner_radius_all": 8, "border_width_all": 1, "border_color": GuStyle.HAIRLINE_COLOR} }><MarginContainer style={ {"margin_left": 12, "margin_right": 12, "margin_top": 10, "margin_bottom": 10} }><VBoxContainer style={ {"separation": 4} }><Label name="hand_tooltip_title" text={ hovered_name } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 16} } /><GuTooltipView title="" quality={ hovered_quality } effect={ hovered_effect } synergy={ str(hovered_card.get("synergy", "")) } cost={ str(hovered_card.get("cost_ex", str(hovered_card.get("cost", "")))) } block_reason={ hovered_block if not hovered_executable else "" } curse_warning={ hovered_curse } /></VBoxContainer></MarginContainer></PanelContainer>)

  return (<VBoxContainer style={ {"separation": 10, "anchors_preset": "PRESET_FULL_RECT"} }>
    <VBoxContainer name="battle_hud"><GuTopBar resources={ state.get("resources", {}) } contracts={ state.get("contracts", []) } anomalies={ state.get("anomalies", []) } death_lines={ state.get("death_lines", {}) } on_view={ func(cid): set_interaction.call({"mode": mode, "card": active_card, "target_id": "", "cause_view": str(cid)}) } /></VBoxContainer>
    <HBoxContainer name="battle_field" style={ {"separation": 20, "size_flags_vertical": 3} }>
      <GuPanel title="我方" expand_h={ true }><VBoxContainer name="player_actor" style={ {"separation": 6} }><GuStatBar label="生命" value={ int(player.get("hp", 0)) } max_value={ maxi(1, int(player.get("max_hp", 1))) } color={ GuStyle.JADE } shield={ int(player.get("shield", 0)) } /><GuStatBar label="真元" value={ int(player.get("primordial", 0)) } max_value={ maxi(1, int(player.get("primordial", 1))) } color={ GuStyle.ANOMALY_YELLOW } /><Label text={ "魂魄并发 %d/%d" % [int(soul_ops.get("used", 0)), int(soul_ops.get("cap", 0))] } style={ {"font_color": GuStyle.INK_MUTED, "font_size": 14} } /></VBoxContainer></GuPanel>
      <GuPanel title="敌方" expand_h={ true }><HBoxContainer name="enemy_group" style={ {"separation": 10} }>{ enemy_rows }</HBoxContainer></GuPanel>
    </HBoxContainer>
    { feedback_rows }
    { hint_rows }
    <VBoxContainer name="battle_hand" style={ {"separation": 8} }><HBoxContainer style={ {"separation": 12} }><Label text={ "真元 %d" % int(player.get("primordial", 0)) } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 18} } /><Label text={ "抽 %d · 弃 %d · 耗 %d" % [int(piles.get("draw", 0)), int(piles.get("discard", 0)), int(piles.get("exhausted", 0))] } style={ {"font_color": GuStyle.INK_MUTED, "font_size": 14} } /></HBoxContainer><GuBattleHand cards={ state.get("hand", []) } interaction={ interaction } on_press={ play_card } on_hover={ func(card): set_interaction.call({"mode": "target_select" if mode == "target_select" else "hover", "card": card, "card_id": str(card.get("id", "")), "target_id": str(interaction.get("target_id", "")), "confirming": bool(interaction.get("confirming", false)), "cause_view": cause_view, "expanded_enemies": bool(interaction.get("expanded_enemies", false))}) } on_drag={ func(card): set_mode.call("dragging", card) } on_release={ play_card } on_cancel={ reset_interaction } />{ kill_rows }<HBoxContainer style={ {"separation": 8} }>{ ops }</HBoxContainer></VBoxContainer>
    <Label name={ "battle_" + mode } text="" />
    { confirm_row }
    { hand_tooltip_rows }
    @if (not cause_line.is_empty()) { return (<GuDeathCauseOverlay line={ cause_line } on_close={ reset_interaction } />) }
  </VBoxContainer>)
}
