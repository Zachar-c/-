@theme "res://assets/theme/gu_theme.tres"
import { GuButton } from "~/ui/widgets/gu_button"
import { GuPanel } from "~/ui/widgets/gu_panel"
import { GuTopBar } from "~/ui/widgets/gu_top_bar"
import { GuScrollBox } from "~/ui/widgets/gu_scroll_box"

# MapScreen —— 地图屏（网状收敛地图、八类节点、统一结算入口）
# 契约：props.state 只读快照（含 nodes/current_node_id/reachable_ids/resources/contracts/anomalies/death_lines）
#       props.commands 动作名 -> Callable（travel / view_node）
# 屏内零业务读写；仅在 on_press 回调中经 commands 触发。
#   commands["travel"].call(id)        前往可达节点
#   commands["view_node"].call(id)     查看节点详情（可选）
# nodes 项字段：{ id, type, label, layer, ... }
# 布局：按 layer 分组（每层一个面板），层数递增、节点递减即体现「网状收敛」。

export MapScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})

  var nodes = state.get("nodes", [])
  var current_id = state.get("current_node_id", "")
  var reachable = state.get("reachable_ids", [])
  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})

  var has_view = commands.has("view_node")

  # 按 layer 分组节点 -> layer(int) : Array[RuitkVNode]
  var by_layer = {}
  var layer_keys = []
  for n in nodes:
    var layer = int(n.get("layer", 0))
    var id = str(n.get("id", ""))
    var label = str(n.get("label", ""))
    if label == "":
      label = str(n.get("type", "节点"))
    var ntype = str(n.get("type", ""))
    var is_current = (id == current_id)
    var is_reach = reachable.has(id)
    var disabled = not is_reach

    var travel_fn = func():
      if commands.has("travel"):
        commands["travel"].call(id)

    var node_children = []
    if is_current:
      node_children.append(<Label text="（当前所在）" style={ {"font_color": GuStyle.GOLD, "font_size": 13} } />)
    var btn_label = "前往" if (is_reach and not is_current) else ("当前" if is_current else "不可达")
    node_children.append(<GuButton label={ btn_label } disabled={ disabled } on_press={ travel_fn } />)
    if has_view:
      var view_fn = func():
        commands["view_node"].call(id)
      node_children.append(<GuButton label="详情" disabled={ disabled } on_press={ view_fn } />)

    var node_panel = (
      <GuPanel title={ "%s · %s" % [label, ntype] }>
        @for (c in node_children) {
          return c
        }
      </GuPanel>
    )

    if not by_layer.has(layer):
      by_layer[layer] = []
      layer_keys.append(layer)
    by_layer[layer].append(node_panel)

  layer_keys.sort()

  var layer_panels = []
  for layer in layer_keys:
    var count = by_layer[layer].size()
    var row = (
      <GuPanel title={ "第 %d 层（%d 节点）" % [layer, count] }>
        <VBoxContainer style={ {"separation": 8} }>
          @for (np in by_layer[layer]) {
            return np
          }
        </VBoxContainer>
      </GuPanel>
    )
    layer_panels.append(row)

  return (
    <VBoxContainer style={ {"separation": 12} }>
      <GuTopBar resources={ resources } contracts={ contracts } anomalies={ anomalies } death_lines={ death_lines } />
      <Label text="网状收敛地图" style={ {"font_color": GuStyle.GOLD, "font_size": 20} } />
      <GuScrollBox>
        @for (lp in layer_panels) {
          return lp
        }
        @if (nodes.is_empty()) {
          return (<Label text="（地图为空）" style={ {"font_color": GuStyle.BONE_DIM, "font_size": 14} } />)
        }
      </GuScrollBox>
    </VBoxContainer>
  )
}
