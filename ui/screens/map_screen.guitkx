import { GuButton } from "~/ui/widgets/gu_button"
import { GuToast } from "~/ui/widgets/gu_toast"

# MapScreen projects the domain-owned topology into a focused route camera.
# Positions are presentation-only: nodes, edges, reachability, and commands remain snapshot-owned.

export MapScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})
  var nodes = state.get("nodes", [])
  var resources = state.get("resources", {})
  var contracts = state.get("contracts", [])
  var anomalies = state.get("anomalies", [])
  var death_lines = state.get("death_lines", {})
  var toast_text = str(state.get("toast", ""))







  var NODE_STYLE = {
    "start": {"mark": "起", "kind": "起始", "color": GuStyle.INK_MAP_FAINT},
    "combat": {"mark": "鬥", "kind": "战斗", "color": GuStyle.INK_MAP},
    "pursuit": {"mark": "鬥", "kind": "追击", "color": GuStyle.INK_MAP},
    "event": {"mark": "？", "kind": "异闻", "color": GuStyle.INK_MAP},
    "shop": {"mark": "市", "kind": "黑市", "color": GuStyle.INK_MAP},
    "market": {"mark": "市", "kind": "商队", "color": GuStyle.INK_MAP},
    "caravan": {"mark": "市", "kind": "商队", "color": GuStyle.INK_MAP},
    "rest": {"mark": "息", "kind": "休整", "color": GuStyle.INK_MAP},
    "seclusion": {"mark": "息", "kind": "静修", "color": GuStyle.INK_MAP},
    "cultivation": {"mark": "息", "kind": "修行", "color": GuStyle.INK_MAP},
    "refinement": {"mark": "市", "kind": "炼蛊", "color": GuStyle.INK_MAP},
    "ascension": {"mark": "險", "kind": "突破", "color": GuStyle.INK_MAP},
  }
  const NODE_SIZE = Vector2(192, 126)
  const FUTURE_NODE_SIZE = Vector2(168, 108)
  const CURRENT_POSITION = Vector2(626, 712)
  const CANDIDATE_Y = 482.0
  const FUTURE_Y = 31.0
  const CANDIDATE_X = [96.0, 626.0, 1156.0]
  const FUTURE_X = [50.0, 403.0, 756.0, 1109.0]

  var current_node = {}
  var history_count = 0
  var visible_layers = []
  for node in nodes:
    var visibility = str(node.get("visibility", "lookahead"))
    if visibility == "past":
      history_count += 1
      continue
    var layer = int(node.get("layer", 0))
    if not visible_layers.has(layer):
      visible_layers.append(layer)
    if visibility == "current" or bool(node.get("current", false)):
      current_node = node
  visible_layers.sort()
  if visible_layers.size() > 3:
    visible_layers = visible_layers.slice(0, 3)

  var nodes_by_layer = {}
  for layer in visible_layers:
    nodes_by_layer[layer] = []
  for node in nodes:
    var layer = int(node.get("layer", 0))
    if nodes_by_layer.has(layer) and str(node.get("visibility", "lookahead")) != "past":
      nodes_by_layer[layer].append(node)

  var selected = {}
  for layer in visible_layers:
    for node in nodes_by_layer[layer]:
      if bool(node.get("reachable", false)):
        selected = node
        break
    if not selected.is_empty():
      break
  if selected.is_empty():
    selected = current_node
  var selected_id = str(selected.get("id", ""))

  var node_positions = {}
  var node_sizes = {}
  for layer_index in visible_layers.size():
    var layer = visible_layers[layer_index]
    var layer_nodes = nodes_by_layer[layer]
    for node_index in layer_nodes.size():
      var node = layer_nodes[node_index]
      var id = str(node.get("id", ""))
      if layer_index == 0:
        node_positions[id] = CURRENT_POSITION
        node_sizes[id] = NODE_SIZE
      elif layer_index == 1:
        node_positions[id] = Vector2(CANDIDATE_X[mini(node_index, CANDIDATE_X.size() - 1)], CANDIDATE_Y)
        node_sizes[id] = NODE_SIZE
      else:
        node_positions[id] = Vector2(FUTURE_X[mini(node_index, FUTURE_X.size() - 1)], FUTURE_Y)
        node_sizes[id] = FUTURE_NODE_SIZE

  var visible_ids = {}
  for node in nodes:
    var id = str(node.get("id", ""))
    if node_positions.has(id):
      visible_ids[id] = true

  var path_segments = []
  var path_geometry = []
  for node in nodes:
    var origin_id = str(node.get("id", ""))
    if not visible_ids.has(origin_id):
      continue
    for next_id_value in node.get("next_ids", []):
      var next_id = str(next_id_value)
      if not visible_ids.has(next_id):
        continue
      var is_selected_branch = origin_id == selected_id or next_id == selected_id
      var segment_name = "map_path_segment_%s_%s" % [origin_id, next_id]
      path_segments.append(<Control name={ segment_name } mouse_filter={ Control.MOUSE_FILTER_IGNORE } />)
      path_geometry.append({
        "from": node_positions[origin_id] + Vector2(node_sizes[origin_id].x * 0.5, 0),
        "to": node_positions[next_id] + Vector2(node_sizes[next_id].x * 0.5, node_sizes[next_id].y),
        "hot": is_selected_branch,
      })

  var path_draw = func(canvas):
    for segment in path_geometry:
      var color = GuStyle.CINNABAR if bool(segment["hot"]) else GuStyle.HAIRLINE_COLOR
      var width = 2.0 if bool(segment["hot"]) else 1.0
      canvas.draw_line(segment["from"], segment["to"], color, width, true)

  var node_controls = []
  for layer_index in visible_layers.size():
    var layer = visible_layers[layer_index]
    for node in nodes_by_layer[layer]:
      var id = str(node.get("id", ""))
      var label = str(node.get("label", node.get("type", "节点")))
      var ntype = str(node.get("type", ""))
      var visual = NODE_STYLE.get(ntype, {"mark": "?", "kind": "未知", "color": GuStyle.INK_MAP_FAINT})
      if ntype == "combat" and str(node.get("enemy_kind", "")).contains("elite"):
        visual = {"mark": "險", "kind": "精英", "color": GuStyle.INK_MAP}
      var reachable = bool(node.get("reachable", false))
      var is_current = str(node.get("visibility", "")) == "current" or bool(node.get("current", false))
      var is_selected = id == selected_id
      var position = node_positions[id]
      var node_size = node_sizes[id]
      var status = "当前所在" if is_current else ("可前往" if reachable else "已知前路")
      var detail = "可提交行路" if reachable else ("上一层未选道路已隐去" if is_current else "后继可查看")
      var node_style = {
        "custom_minimum_size": node_size,
        "bg_color": GuStyle.PAPER_MAP if not is_current else Color(0, 0, 0, 0),
        "border_width_all": GuStyle.HAIRLINE,
        "border_width_left": 4 if (is_current or is_selected) else GuStyle.HAIRLINE,
        "border_color": GuStyle.CINNABAR if (is_current or is_selected) else GuStyle.INK_MAP_FAINT,
        "content_margin_left": 12,
        "content_margin_right": 10,
        "content_margin_top": 9,
        "content_margin_bottom": 7,
        "modulate": Color(1, 1, 1, 1) if (is_current or reachable or is_selected) else Color(1, 1, 1, 0.58),
        "focus": {"border_width_all": 2, "border_color": GuStyle.CINNABAR},
      }
      var node_action = func():
        if reachable and commands.has("travel"):
          commands["travel"].call(id)
        elif commands.has("view_node"):
          commands["view_node"].call(id)
      node_controls.append((
        <Button name={ "map_node_" + id } text="" position={ position } onPressed={ node_action } style={ node_style }>
          <VBoxContainer style={ {"separation": 2} }>
            <HBoxContainer style={ {"separation": 9} }>
              <PanelContainer name={ "map_node_mark_" + id } custom_minimum_size={ Vector2(30, 30) } style={ {"bg_color": Color(0, 0, 0, 0), "border_width_all": 1, "border_color": visual["color"], "corner_radius_all": 15} }><CenterContainer><Label name={ "map_node_mark_label_" + id } text={ str(visual["mark"]) } horizontal_alignment={ HORIZONTAL_ALIGNMENT_CENTER } vertical_alignment={ VERTICAL_ALIGNMENT_CENTER } style={ {"font_color": visual["color"], "font_size": 12} } /></CenterContainer></PanelContainer>
              <Label text={ label } vertical_alignment={ VERTICAL_ALIGNMENT_CENTER } style={ {"font_color": GuStyle.INK_MAP, "font_size": 20 if layer_index < 2 else 17} } />
            </HBoxContainer>
            <Label text={ str(visual["kind"]) + " · " + status } style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 10} } />
            <Label text={ detail } style={ {"font_color": GuStyle.CINNABAR if reachable else GuStyle.INK_MAP_FAINT, "font_size": 9} } />
          </VBoxContainer>
        </Button>
      ))

  var inspection_name = str(selected.get("label", "尚未选择路线"))
  var inspection_type = str(selected.get("type", ""))
  var inspection_reachable = bool(selected.get("reachable", false))
  var inspection_note = "此节点可进入，提交前由领域校验行路状态。" if inspection_reachable else "查看路线信息；不可达节点不会提交行路命令。"
  var inspector_action = []
  if inspection_reachable and commands.has("travel"):
    inspector_action.append(<GuButton label="前往此路 ›" on_press={ func(): commands["travel"].call(selected_id) } size="large" />)
  elif commands.has("view_node") and not selected.is_empty():
    inspector_action.append(<GuButton label="查看此路" on_press={ func(): commands["view_node"].call(selected_id) } />)

  var toast_row = []
  if toast_text != "":
    toast_row.append(<GuToast text={ toast_text } tone="info" />)
  var save_row = []
  if commands.has("save_run"):
    save_row.append(<GuButton label="存档" on_press={ func(): commands["save_run"].call() } />)

  var resource_rows = []
  var resource_specs = [
    {"id": "yuanstone", "name": "元石", "suffix": ""},
    {"id": "shouyuan", "name": "寿元", "suffix": " 年"},
    {"id": "hunpo", "name": "魂魄", "suffix": ""},
    {"id": "material", "name": "材料", "suffix": ""},
  ]
  for spec in resource_specs:
    var resource_id = str(spec["id"])
    if resources.has(resource_id):
      resource_rows.append(
        <HBoxContainer style={ {"separation": 4} } key={ resource_id }>
          <Label name={ "map_resource_value_" + resource_id } text={ str(resources[resource_id]) + str(spec["suffix"]) } style={ {"font_color": GuStyle.INK_MAP_VALUE, "font_size": 13} } />
          <Label name={ "map_resource_name_" + resource_id } text={ str(spec["name"]) } style={ {"font_color": GuStyle.INK_MAP_NAME, "font_size": 10} } />
        </HBoxContainer>
      )

  return (
    <Control style={ {"anchors_preset": "PRESET_FULL_RECT"} }>
      <ColorRect name="map_paper" color={ GuStyle.PAPER_MAP } mouse_filter={ Control.MOUSE_FILTER_IGNORE } style={ {"anchors_preset": "PRESET_FULL_RECT"} } />
      { toast_row }
      <HBoxContainer name="map_mast" anchor_left={ 0.0 } anchor_right={ 1.0 } offset_left={ 30.0 } offset_right={ -30.0 } offset_top={ 20.0 } offset_bottom={ 68.0 } style={ {"border_width_bottom": 1, "border_color": GuStyle.HAIRLINE_COLOR} }>
        <Label text="問眞　/　命蠱第六十三卷　/　南疆" style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 10, "size_flags_horizontal": "SIZE_EXPAND_FILL"} } />
        <HBoxContainer name="map_resources" style={ {"separation": 19} }>{ resource_rows }</HBoxContainer>
      </HBoxContainer>
      <HBoxContainer name="map_markers" position={ Vector2(31, 80) } style={ {"separation": 13} }>
        <Label text={ "契约 · " + (str(contracts[0]) if not contracts.is_empty() else "无") } style={ {"font_color": GuStyle.CONTRACT_BLUE, "font_size": 9, "border_width_left": 2, "border_color": GuStyle.CONTRACT_BLUE, "content_margin_left": 7} } />
        <Label text={ "异变 · " + (str(anomalies[0]) if not anomalies.is_empty() else "无") } style={ {"font_color": GuStyle.ANOMALY_YELLOW, "font_size": 9, "border_width_left": 2, "border_color": GuStyle.ANOMALY_YELLOW, "content_margin_left": 7} } />
      </HBoxContainer>
      <HBoxContainer name="map_title" anchor_left={ 0.055 } anchor_right={ 0.945 } offset_top={ 110.0 } offset_bottom={ 142.0 }>
        <Label text="青茅山外圍" style={ {"font": GuStyle.TITLE_FONT, "font_color": GuStyle.INK_MAP, "font_size": 28} } />
        <Label text="深度 62 · 四轉初階" style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 10, "content_margin_left": 12} } />
      </HBoxContainer>
      <Control name="map_camera" clip_contents={ true } anchor_left={ 0.055 } anchor_right={ 0.945 } anchor_bottom={ 1.0 } offset_top={ 158.0 } offset_bottom={ -92.0 }>
        <Panel name="map_camera_backdrop" mouse_filter={ Control.MOUSE_FILTER_IGNORE } style={ {"anchors_preset": "PRESET_FULL_RECT", "border_width_top": 1, "border_width_bottom": 1, "border_color": GuStyle.HAIRLINE_COLOR, "bg_color": GuStyle.PAPER_MAP} } />
        <Control name="map_depth" mouse_filter={ Control.MOUSE_FILTER_IGNORE } anchor_top={ 0.0 } anchor_bottom={ 1.0 } offset_top={ 0.0 } offset_bottom={ 0.0 } offset_right={ 58.0 } style={ {"border_width_right": 1, "border_color": GuStyle.HAIRLINE_COLOR, "z_index": 3} }>
          <Label name="map_depth_65" text="65" anchor_right={ 1.0 } offset_right={ -13.0 } offset_top={ 18.0 } offset_bottom={ 36.0 } horizontal_alignment={ HORIZONTAL_ALIGNMENT_RIGHT } style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 9} } />
          <Label name="map_depth_64" text="64" anchor_right={ 1.0 } offset_right={ -13.0 } offset_top={ 248.0 } offset_bottom={ 266.0 } horizontal_alignment={ HORIZONTAL_ALIGNMENT_RIGHT } style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 9} } />
          <Label name="map_depth_63" text="63" anchor_right={ 1.0 } offset_right={ -13.0 } offset_top={ 478.0 } offset_bottom={ 496.0 } horizontal_alignment={ HORIZONTAL_ALIGNMENT_RIGHT } style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 9} } />
          <Label name="map_depth_62" text="62" anchor_right={ 1.0 } offset_right={ -13.0 } offset_top={ 708.0 } offset_bottom={ 726.0 } horizontal_alignment={ HORIZONTAL_ALIGNMENT_RIGHT } style={ {"font_color": GuStyle.INK_MAP_FAINT, "font_size": 9} } />
        </Control>
        <Control name="map_world" anchor_right={ 1.0 } anchor_top={ 1.0 } anchor_bottom={ 1.0 } offset_top={ -970.0 }>
          <Control name="map_routes" anchor_left={ 0.0 } anchor_right={ 1.0 } anchor_bottom={ 1.0 } offset_left={ 70.0 }>
            <Label name="map_layer_label_far" text="再前一程" position={ Vector2(0, 4) } style={ {"font_color": GuStyle.INK_MAP_LABEL, "font_size": 10} } />
            <Label name="map_layer_label_near" text="下一程" position={ Vector2(0, 234) } style={ {"font_color": GuStyle.INK_MAP_LABEL, "font_size": 10} } />
            <Label name="map_layer_label_now" text="此刻" position={ Vector2(0, 464) } style={ {"font_color": GuStyle.INK_MAP_LABEL, "font_size": 10} } />
            <Control name="map_paths" mouse_filter={ Control.MOUSE_FILTER_IGNORE } draw_fn={ path_draw } redraw_key={ path_geometry } style={ {"anchors_preset": "PRESET_FULL_RECT", "z_index": 1} }>{ path_segments }</Control>
            <Control mouse_filter={ Control.MOUSE_FILTER_IGNORE } style={ {"anchors_preset": "PRESET_FULL_RECT", "z_index": 2} }>{ node_controls }</Control>
          </Control>
        </Control>
      </Control>
      <HBoxContainer name="map_inspector" anchor_left={ 0.055 } anchor_right={ 0.945 } anchor_top={ 1.0 } anchor_bottom={ 1.0 } offset_top={ -72.0 } offset_bottom={ -24.0 } style={ {"separation": 18} }>
          <VBoxContainer style={ {"separation": 2, "size_flags_horizontal": "SIZE_EXPAND_FILL"} }>
            <Label name="map_inspection_name" text={ inspection_name } style={ {"font_color": GuStyle.INK_MAP, "font_size": 18} } />
            <Label name="map_inspection_note" text={ inspection_type + " · " + inspection_note } style={ {"font_color": GuStyle.INK_MAP_NOTE, "font_size": 11} } />
          </VBoxContainer>
          { inspector_action }
          { save_row }
      </HBoxContainer>
    </Control>
  )
}
