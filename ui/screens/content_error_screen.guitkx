import { GuButton } from "~/ui/widgets/gu_button"

export ContentErrorScreen() -> RuitkVNode {
  var state = props.get("state", {})
  var commands = props.get("commands", {})
  var errors = state.get("errors", [])
  var rows = []
  for error in errors:
    rows.append(<Label text={ "· " + str(error) } style={ {"font_color": GuStyle.CINNABAR, "font_size": 14} } />)
  return (
    <ColorRect color={ GuStyle.PAPER_BG } style={ {"anchors_preset": "PRESET_FULL_RECT"} }>
      <CenterContainer style={ {"anchors_preset": "PRESET_FULL_RECT"} }>
        <VBoxContainer style={ {"separation": 12, "custom_minimum_size": Vector2(620, 0)} }>
          <Label text={ str(state.get("title", "内容配置无法加载")) } style={ {"font_color": GuStyle.CINNABAR, "font_size": 28} } />
          <Label text={ "请修复数据文件后重新启动。错误数：%d" % int(state.get("error_count", 0)) } style={ {"font_color": GuStyle.INK_PRIMARY, "font_size": 16} } />
          { rows }
          <GuButton label="退出" on_press={ func(): if commands.has("quit"): commands["quit"].call() } />
        </VBoxContainer>
      </CenterContainer>
    </ColorRect>
  )
}
