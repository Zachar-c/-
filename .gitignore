# Local test output, backups, sabotage/debug logs, and generated shortlist files.
/map_test_result.txt
**/*.bak-*
**/gate_sabotage.log
**/generated/_shortlist_spec.txt
gu-zhenren-editor/tools/_*.txt
game/tools/_*.txt

# Common local OS/editor noise.
**/.DS_Store
**/Thumbs.db

# Local browser verification caches and captured proof output.
/.playwright-cli/
/output/

