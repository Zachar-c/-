{
  "$schema": "design-tokens-v1",
  "name": "destiny-card-roguelike",
  "mode": "dark-primary",
  "primitive": {
    "color": {
      "night/0": "#05070C",
      "night/1": "#0A0F18",
      "night/2": "#121A28",
      "night/3": "#1A2436",
      "night/4": "#243248",
      "night/5": "#3A4C68",
      "lumen/100": "#F6F1E6",
      "lumen/80": "#D9D2C4",
      "lumen/60": "#A89F90",
      "lumen/40": "#6E675C",
      "lumen/gold": "#D4B46A",
      "lumen/gold-deep": "#A8843C",
      "lumen/glow": "#F0E2B0",
      "mark/force": "#C47B5A",
      "mark/soul": "#7B8FD4",
      "mark/blood": "#B54A4A",
      "mark/wisdom": "#6BA3A0",
      "mark/wood": "#7A9E6A",
      "mark/time": "#9B7EC8",
      "state/danger": "#D45B5B",
      "state/success": "#6FAF8A",
      "state/warn": "#D4B46A",
      "state/info": "#6B8FBF"
    },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
    "radius": { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "full": 999 },
    "stroke": { "hair": 1, "em": 2, "card": 1 },
    "type": {
      "d1": 40, "d2": 28, "h": 20, "b": 15, "s": 13, "cap": 11,
      "num-lg": 32, "num-md": 18
    }
  },
  "semantic": {
    "bg/page": "night/1",
    "bg/surface": "night/2",
    "bg/raised": "night/3",
    "text/primary": "lumen/100",
    "text/secondary": "lumen/80",
    "text/muted": "lumen/60",
    "text/disabled": "lumen/40",
    "text/on-gold": "night/0",
    "accent/primary": "lumen/gold",
    "accent/border": "lumen/gold-deep",
    "accent/glow": "lumen/glow",
    "border/subtle": "night/4",
    "border/strong": "night/5",
    "border/fate": "lumen/gold-deep",
    "action/primary-bg": "lumen/gold",
    "action/primary-fg": "night/0",
    "action/danger-fg": "state/danger",
    "feedback/danger": "state/danger",
    "feedback/success": "state/success",
    "feedback/warn": "state/warn",
    "meter/hp": "mark/blood",
    "meter/qi": "mark/wisdom",
    "meter/life": "mark/time"
  },
  "font": {
    "display": "Noto Serif SC",
    "ui": "Noto Sans SC",
    "mono": "Roboto Mono"
  },
  "effects": {
    "glow-gold": { "type": "drop", "x": 0, "y": 0, "blur": 12, "color": "#D4B46A", "opacity": 0.35 },
    "glow-soft": { "type": "drop", "x": 0, "y": 0, "blur": 24, "color": "#F0E2B0", "opacity": 0.18 },
    "card-rest": { "type": "drop", "x": 0, "y": 8, "blur": 24, "color": "#000000", "opacity": 0.45 },
    "card-hover": { "type": "drop", "x": 0, "y": 12, "blur": 32, "color": "#000000", "opacity": 0.55 }
  }
}
